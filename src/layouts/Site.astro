---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import {
  assetUrl,
  formatDateJa,
  siteDescription,
  introductionForPath,
  staticLastUpdatedForPath,
  url,
  publicEntry,
} from "../lib/site";
import { navigation } from "../lib/navigation";
const retiredNavigation = navigation.flat().find((item) => item.path === "retired")!;
import NavIcon from "../components/NavIcon.astro";
import ReferencePanel from "../components/ReferencePanel.astro";
import RightSidebarControls from "../components/RightSidebarControls.astro";
import { pageContents } from "../lib/page-contents.mjs";
import GlobalSearch from "../components/GlobalSearch.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import { getCollection } from "astro:content";
import { analyticsMetadata } from "../lib/analytics";
interface Props {
  title: string;
  analyticsTitle?: string;
  summary?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  section?: string;
  headings?: { depth: number; slug: string; text: string }[];
  noindex?: boolean;
  internalSearch?: boolean;
  searchLifecycle?: "active" | "obsolete" | "retired";
  publishedAt?: string | null;
  lastUpdated?: string;
  showLastUpdated?: boolean;
  breadcrumbs?: { name: string; path: string }[];
  bookNavigation?: {
    title: string;
    chapterCount: number;
    items: { title: string; href: string; current: boolean }[];
  };
  frame?: boolean;
  showRightSidebar?: boolean;
  showReference?: boolean;
  rightSidebarCollapsible?: boolean;
  mobilePageToc?: boolean;
  pageTocDepth?: number;
  toc?: "auto" | "never" | "always";
}
const {
  title,
  analyticsTitle = title,
  summary = introductionForPath(Astro.url.pathname) ?? siteDescription,
  canonical,
  ogImage = "og/site.png",
  ogType = "website",
  section,
  headings = [],
  noindex = false,
  internalSearch = !noindex,
  searchLifecycle = "active",
  publishedAt,
  lastUpdated,
  showLastUpdated = true,
  breadcrumbs = [],
  bookNavigation,
  frame = true,
  showRightSidebar = true,
  showReference = true,
  rightSidebarCollapsible = true,
  toc = "auto",
} = Astro.props;
const contents = pageContents(await Astro.slots.render("default"), { headings, mode: showRightSidebar ? toc : "never" });
const pageHeadings = contents.headings;
const hasPageToc = !!bookNavigation?.items.length || pageHeadings.length > 0;
const referenceSidebar = showRightSidebar && (hasPageToc || showReference);
const effectiveLastUpdated =
  lastUpdated ?? staticLastUpdatedForPath(Astro.url.pathname);
const analyticsEntry = (await getCollection("pages", publicEntry)).find(
  (entry) => url(entry.id) === Astro.url.pathname,
);
const analyticsPage = analyticsMetadata(Astro.url.pathname, analyticsTitle, analyticsEntry);
const documentTitle =
  title === "Home" ? "Rosarium | 立林 裕太朗" : `${title} | Rosarium`;
const canonicalUrl = canonical?.startsWith(
  "https://nullcontroller.github.io/Rosarium/",
)
  ? canonical
  : new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = ogImage.startsWith("http")
  ? ogImage
  : new URL(assetUrl(ogImage), Astro.site).toString();
const siteUrl = new URL(assetUrl(""), Astro.site).toString();
const personId = `${siteUrl}#person`;
const websiteId = `${siteUrl}#website`;
const collectionSections = new Set([
  "ai-design",
  "ai-mathematics",
  "ai",
  "practices",
  "cases",
  "articles",
  "dx",
  "books",
  "series",
  "essays",
  "overview",
  "reference",
  "updates",
]);
const readingSections = new Set([
  "ai",
  "articles",
  "ai-design",
  "ai-mathematics",
  "practices",
  "books",
  "series",
  "essays",
]);
const pageType =
  ogType === "article"
    ? "TechArticle"
    : ogType === "profile"
      ? "ProfilePage"
      : collectionSections.has(section || "") || section?.startsWith("dx/")
        ? "CollectionPage"
        : "WebPage";
const breadcrumbId = `${canonicalUrl}#breadcrumb`;
const pageEntity = {
  "@type": pageType,
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: documentTitle,
  ...(ogType === "article" ? { headline: title } : {}),
  description: summary,
  inLanguage: "ja",
  isPartOf: { "@id": websiteId },
  author: { "@id": personId },
  primaryImageOfPage: { "@type": "ImageObject", url: ogImageUrl },
  ...(publishedAt ? { datePublished: publishedAt } : {}),
  ...(effectiveLastUpdated ? { dateModified: effectiveLastUpdated } : {}),
  ...(breadcrumbs.length ? { breadcrumb: { "@id": breadcrumbId } } : {}),
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteUrl,
      name: "Rosarium",
      description: siteDescription,
      inLanguage: "ja",
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "立林 裕太朗",
      url: new URL(url("career"), Astro.site).toString(),
    },
    pageEntity,
    ...(breadcrumbs.length
      ? [
          {
            "@type": "BreadcrumbList",
            "@id": breadcrumbId,
            itemListElement: breadcrumbs.map((item, index) => ({
              "@type": "ListItem",
              position: index + 1,
              name: item.name,
              item: item.path.startsWith("http")
                ? item.path
                : new URL(url(item.path), Astro.site).toString(),
            })),
          },
        ]
      : []),
  ],
};
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta name="analytics-content-type" content={analyticsPage.content_type} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={summary} />
    <meta name="content-lifecycle" content={searchLifecycle} data-pagefind-meta="lifecycle[content]" data-pagefind-filter="lifecycle[content]" />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#17383b" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${title} — Rosarium`} />
    <meta property="og:site_name" content="Rosarium" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${title} — Rosarium`} />
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}
    {effectiveLastUpdated && (
      <meta property="article:modified_time" content={effectiveLastUpdated} />
    )}
    <meta name="last-updated" content={effectiveLastUpdated} />
    {bingVerification && (
      <meta name="msvalidate.01" content={bingVerification} />
    )}
    <title>{documentTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={assetUrl("favicon.svg")} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={assetUrl("icons/favicon-32x32.png")}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={assetUrl("icons/apple-touch-icon.png")}
    />
    <link rel="manifest" href={assetUrl("site.webmanifest")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Rosarium | Articles"
      href={assetUrl("feed.xml")}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title="Rosarium | Articles"
      href={assetUrl("feed.json")}
    />
    <link
      rel="search"
      type="application/opensearchdescription+xml"
      title="Rosarium"
      href={assetUrl("opensearch.xml")}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
    <slot name="head" />
    <GoogleAnalytics page={analyticsPage} enabled={!noindex && title !== "404"} />
  </head>
  <body class:list={[section === "" && "home-page", !frame && "career-page"]}>
    <a class="skip" href="#main">
      本文へ移動
    </a>
    <header class:list={["masthead", !frame && "career-masthead"]}>
      <a class="brand" href={url()}>
        <img
          class="brand-mark"
          src={assetUrl("favicon.svg")}
          width="40"
          height="40"
          alt=""
          aria-hidden="true"
        />
        <span class="brand-name">Rosarium</span>
      </a>
      <div class="header-links">
        <nav class="header-primary" aria-label="主要ページ">
          <div class="header-primary-group">
          <a href={url()} aria-current={section === "" ? "page" : undefined}>
            庭
          </a>
          <a
            href={url("ai")}
            aria-current={
              readingSections.has(section || "") ? "page" : undefined
            }
          >
            AI
          </a>
          <a
            href={url("dx")}
            aria-current={section === "dx" ? "page" : undefined}
          >
            DX
          </a>
          <a
            href={url("cases")}
            aria-current={section === "cases" ? "page" : undefined}
          >
            事例
          </a>
          </div>
          <a class="mobile-retired-link" aria-label={retiredNavigation.title} href={url(retiredNavigation.path)} aria-current={section === retiredNavigation.path ? "page" : undefined}>
            {retiredNavigation.shortLabel ?? retiredNavigation.title}
          </a>
        </nav>
        <div class="header-actions">
          {showRightSidebar && showReference && <a class="reference-header-tool" href={url("reference")} data-reference-toggle aria-label="Referenceを開く" aria-controls="reference-panel" aria-expanded="false">参照</a>}
          <GlobalSearch />
          <button id="theme" type="button" aria-label="配色を切り替える">
            配色切替
          </button>
        </div>
      </div>
    </header>
    <div
      class:list={[
        "shell",
        frame && "global-frame",
        !frame && "career-shell",
        !showRightSidebar && "standalone-reading",
        referenceSidebar && "has-toc",
        referenceSidebar && bookNavigation && "has-book-toc",
      ]}
    >
      {frame && (
        <aside class="sidebar" aria-label="主要ナビゲーション">
          <div class="sidebar-navigation">
            <p class="sidebar-label">ナビゲーション</p>
            <nav>
              {navigation.map((group, i) => (
                <div
                  class:list={[
                    "nav-group",
                    i === 1 && "nav-spacing",
                    i === 2 && "nav-lifecycle",
                    i >= 2 && "nav-divider",
                    i >= 2 ? "nav-auxiliary" : "nav-main",
                  ]}
                  role="group"
                  aria-label={i === 2 ? retiredNavigation.title : "主要ナビ"}
                >
                  {group.map((item) => (
                    <div
                      class:list={["nav-item", item.children && "nav-parent"]}
                    >
                      <a
                        href={url(item.path)}
                        aria-current={
                          section === item.path ? "page" : undefined
                        }
                        data-section-active={
                          item.sections?.includes(section || "") ||
                          item.children?.some(
                            (child) =>
                              child.path === section ||
                              child.sections?.includes(section || ""),
                          )
                            ? true
                            : undefined
                        }
                      >
                        <NavIcon name={item.icon} />
                        <span class="nav-copy">
                          <span>{item.title}</span>
                          <small>{item.summary}</small>
                        </span>
                      </a>
                      {item.children && (
                        <div
                          class="nav-children"
                          aria-label={`${item.title}のカテゴリ`}
                        >
                          {item.children.map((child) => (
                            <a
                              href={`${url(child.path)}${child.hash ? `#${child.hash}` : ""}`}
                              aria-current={
                                section === child.path ? "page" : undefined
                              }
                              data-section-active={
                                child.sections?.includes(section || "")
                                  ? true
                                  : undefined
                              }
                            >
                              <span class="nav-copy">
                                <span>{child.title}</span>
                                <small>{child.summary}</small>
                              </span>
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              ))}
            </nav>
          </div>
        </aside>
      )}
      <main
        id="main"
        tabindex="-1"
        data-pagefind-ignore={!internalSearch ? true : undefined}
        data-toc-policy={showRightSidebar ? toc : "never"}
        data-toc-reason={contents.reason}
      >
        {!noindex && showLastUpdated && (
          <p class="site-last-updated" data-last-updated={effectiveLastUpdated}>
            最終更新：
            <time datetime={effectiveLastUpdated}>
              {formatDateJa(effectiveLastUpdated)}
            </time>
          </p>
        )}
        {bookNavigation && (
          <details class="book-toc-mobile">
            <summary>
              このBookの目次（全{bookNavigation.chapterCount}章）
            </summary>
            <ol>
              {bookNavigation.items.map((item) => (
                <li class:list={[item.current && "current"]}>
                  <a
                    href={item.href}
                    aria-current={item.current ? "page" : undefined}
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )}
        {pageHeadings.length > 0 && <details class="book-toc-mobile" data-page-heading-toc><summary>目次</summary><ol>{pageHeadings.map((h) => <li class:list={[h.depth === 3 && "sub"]}><a href={"#" + h.slug}>{h.text}</a></li>)}</ol></details>}
        <Fragment set:html={contents.html} />
      </main>
      {referenceSidebar && (
        <aside data-collapsible={String(rightSidebarCollapsible)} id="right-sidebar" class:list={[bookNavigation ? "book-toc" : "toc", "reference-sidebar"]} aria-label="右補助パネル">
          <div class="right-sidebar-toolbar">
          <div class="reference-tabs" role="tablist" aria-label="右補助パネルの表示">
            {hasPageToc && <button id="page-toc-tab" type="button" role="tab" aria-selected="true" aria-controls="page-toc-panel">目次</button>}
            {showReference && <button id="reference-sidebar-tab" type="button" role="tab" aria-selected={hasPageToc ? "false" : "true"} aria-controls="reference-panel" tabindex={hasPageToc ? -1 : 0}>リファレンス</button>}
          </div>
          </div>
          {hasPageToc && <div id="page-toc-panel" class="page-toc-panel" role="tabpanel" aria-labelledby="page-toc-tab">
            {bookNavigation ? <>
              <p class="book-toc-title">{bookNavigation.title}</p>
              <ol>{bookNavigation.items.map((item) => <li class:list={[item.current && "current"]}><a href={item.href} aria-current={item.current ? "page" : undefined}>{item.title}</a></li>)}</ol>
            </> : null}
            {pageHeadings.length > 0 && <div data-page-heading-toc>
              {bookNavigation && <p class="page-toc-caption">このページの見出し</p>}
              <ol>{pageHeadings.map((h) => <li class:list={[h.depth === 3 && "sub"]}><a href={"#" + h.slug}>{h.text}</a></li>)}</ol>
            </div>}
          </div>}
          {showReference && <div data-reference-sidebar-slot></div>}
          {showReference && <noscript><style>.reference-tabs { display: none; }</style><p><a href={url("reference")}>Referenceページを開く</a></p></noscript>}
        </aside>
      )}
    </div>
    {referenceSidebar && <RightSidebarControls collapsible={rightSidebarCollapsible} />}
    {showRightSidebar && showReference && <ReferencePanel />}
    <footer class="site-footer">
      <div class="footer-brand">
        <strong>Rosarium</strong>
        <span>学習と実務を通じて育て続ける「庭」</span>
      </div>
      <nav aria-label="フッター">
        <a href={url()}>庭</a> · <a href={url("ai")}>AI</a> ·{" "}
        <a href={url("dx")}>DX</a> · <a href={url("cases")}>実践事例</a> ·{" "}
        <a href={url("career")}>キャリア</a> ·{" "}
        <a href={assetUrl("feed.xml")}>RSS</a>
      </nav>
      <p class="meta" data-pagefind-ignore>
        利用状況を把握し、コンテンツや導線を改善するため、Google Analytics
        4を使用しています。Cookieなどを通じて閲覧・端末情報を収集します。
        <a href="https://policies.google.com/technologies/partner-sites?hl=ja">
          Googleによるデータの利用について
        </a>
      </p>
    </footer>
    <script>
      // Shared page-heading navigation: desktop and mobile use the same targets.
      const headingLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-page-heading-toc] a[href^='#']")];
      const targets = [...new Set(headingLinks.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))))].filter((target): target is HTMLElement => !!target);
      if (targets.length) {
        const masthead = document.querySelector<HTMLElement>(".masthead");
        const headingOffset = () => (masthead?.getBoundingClientRect().height ?? 88) + 24;
        const syncOffset = () => document.documentElement.style.setProperty("--toc-scroll-offset", headingOffset() + "px");
        syncOffset();
        if (masthead) new ResizeObserver(syncOffset).observe(masthead);
        const updateHeading = () => {
          const atEnd = window.scrollY > 0 && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
          const current = atEnd ? targets[targets.length - 1] : [...targets].reverse().find((target) => target.getBoundingClientRect().top <= headingOffset() + 2) || targets[0];
          headingLinks.forEach((link) => {
            if (decodeURIComponent(link.hash.slice(1)) === current.id) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          });
        };
        let pending = false;
        window.addEventListener("scroll", () => {
          if (pending) return;
          pending = true;
          requestAnimationFrame(() => { updateHeading(); pending = false; });
        }, { passive: true });
        updateHeading();
      }
      const theme = document.querySelector("#theme");
      try {
        const saved = localStorage.getItem("adf-theme");
        if (saved) document.documentElement.dataset.theme = saved;
      } catch {}
      theme?.addEventListener("click", () => {
        const dark =
          document.documentElement.dataset.theme === "dark" ||
          (!document.documentElement.dataset.theme &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        const next = dark ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("adf-theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
