---
import Site from "../../layouts/Site.astro";
import { getEntry } from "astro:content";
import { url } from "../../lib/site";
const entry = await getEntry("pages", "evaluation-hitl/customer-support-qa-poc");
const destination = url("cases/customer-support-ai-dx/poc-evaluation");
const canonical = new URL(destination, Astro.site).toString();
---

<Site title="PoC詳細は第03章へ移転しました" summary={entry!.data.summary} canonical={canonical} noindex showRightSidebar={false} showLastUpdated={false} lastUpdated={entry!.data.last_updated}>
  <meta slot="head" http-equiv="refresh" content={`0;url=${destination}`} />
  <script is:inline define:vars={{ destination }}>
    location.replace(destination + location.hash);
  </script>
  <h1>PoC詳細は第03章へ移転しました</h1>
  <p><a href={destination}>第03章：PoCによる方式の検証へ移動する</a></p>
</Site>
