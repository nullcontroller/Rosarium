---
import Site from "../../layouts/Site.astro";
import { url } from "../../lib/site";

const successor = url("evaluation-hitl/responsibility-and-hitl");
const canonical = new URL(successor, Astro.site).toString();
---

<Site
  title="AI Reviewの記事を統合しました"
  summary="AI出力をレビューする人の役割は、責任境界とHITLを扱う後継Knowledgeへ統合しました。"
  canonical={canonical}
  noindex
  showLastUpdated={false}
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${successor}`} />
  <script is:inline define:vars={{ successor }}>
    location.replace(successor);
  </script>
  <h1>AI Reviewの記事を統合しました</h1>
  <p>
    人間の確認能力、承認権限、移管条件、記録は、責任境界とHITLの設計として整理しています。
  </p>
  <p>
    <a href={successor}>「AI出力の責任境界とHITL」へ移動する</a>
  </p>
</Site>
