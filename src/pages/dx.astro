---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import PageHeader from "../components/PageHeader.astro";
import DomainThemeSection from "../components/DomainThemeSection.astro";
import { dxCategories, dxFeaturedArticles } from "../lib/dx";
import { activeEntry, url } from "../lib/site";
const all = await getCollection("pages", activeEntry);
const categoryGroups = dxCategories.map((category) => ({
  ...category,
  articles: dxFeaturedArticles(all, category.id),
}));
const headings = dxCategories.map((category) => ({
  depth: 2,
  slug: category.id,
  text: category.title,
}));
---

<Site title="DX" section="dx" headings={headings}>
  <PageHeader alignHero navigationPath="dx" title="DX" eyebrow="DIGITAL TRANSFORMATION" />
  <p>DXは業務・価値・組織の変化を扱います。システム化の目的・範囲・投資の優先順位を決める判断は、<a href={url("planning")}>企画</a>で整理します。</p>
  <section class="dx-category-list" aria-label="DXのテーマ別記事">
    <span id="dx-themes-heading" aria-hidden="true"></span>
    {categoryGroups.map((category) => (
      <DomainThemeSection
        {...category}
        path={`dx/${category.id}`}
        paragraphs={[category.scope]}
        domain="dx"
      />
    ))}
  </section>
</Site>
