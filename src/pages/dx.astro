---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import PageHeader from "../components/PageHeader.astro";
import ContentIndex from "../components/ContentIndex.astro";
import { publicEntry, url } from "../lib/site";
import { dxTopics, hasTheme } from "../lib/themes";

const all = await getCollection("pages", publicEntry);
const groups = dxTopics
  .map((topic) => ({
    ...topic,
    entries: all
      .filter(
        (entry) =>
          hasTheme(entry, "dx") &&
          entry.data.dx_topic === topic.key &&
          (!entry.data.series || entry.data.order === 0),
      )
      .sort((a, b) => a.data.title.localeCompare(b.data.title, "ja")),
  }))
  .filter((group) => group.entries.length > 0);
---

<Site
  title="DX"
  section="dx"
  summary="AIを何のために使うのかを考えるために、価値・業務変革・システム企画を扱います。"
>
  <PageHeader
    title="DX"
    eyebrow="SURROUNDING DOMAIN"
    summary="AIを何のために使うのかを考えるために、価値・業務変革・システム企画を扱います。"
  />
  <p>
    Rosariumの主軸はAIです。DXは、技術導入を目的化せず、誰にどのような価値を生み出し、業務やサービスをどう変えるかを考える周辺領域として扱います。
  </p>
  <p class="domain-cross-link"><a href={url("articles")}>AIの入口を見る →</a></p>
  {groups.map((group) => (
    <section aria-labelledby={`dx-${group.key}`}>
      <h2 id={`dx-${group.key}`}>{group.label}</h2>
      <p>{group.summary}</p>
      <ContentIndex entries={group.entries} showIcons={false} />
    </section>
  ))}
</Site>
