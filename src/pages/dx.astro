---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import PageHeader from "../components/PageHeader.astro";
import { dxCategories, dxEntriesForCategory } from "../lib/dx";
import { url } from "../lib/site";

const all = await getCollection("pages", ({ data }) => data.public !== false);
const categoryGroups = dxCategories.map((category) => {
  const entries = dxEntriesForCategory(all, category.id);
  const byId = new Map(entries.map((entry) => [entry.id, entry]));
  return {
    ...category,
    articles: category.featured.flatMap((id) => {
      const entry = byId.get(id);
      return entry ? [entry] : [];
    }),
    cases: category.featuredCases.flatMap((id) => {
      const entry = byId.get(id);
      return entry ? [entry] : [];
    }),
  };
});
---

<Site title="DX" section="dx">
  <PageHeader title="DX" eyebrow="DIGITAL TRANSFORMATION" />
  <p>
    Rosariumでは、DXをデジタル技術の導入そのものとは捉えません。何を、なぜ変えるのかを価値から考え、業務・システム・運用を継続して設計し直します。AIは、その変革を実現する有力な手段の一つです。
  </p>

  <section class="dx-category-list" aria-labelledby="dx-themes-heading">
    <h2 id="dx-themes-heading">DXを考える5つのテーマ</h2>
    {categoryGroups.map((category) => (
      <section class="dx-category" id={category.id}>
        <h3>
          <a href={url(`dx/${category.id}`)}>{category.title}</a>
        </h3>
        <p>{category.summary}</p>
        {category.articles.length > 0 && (
          <div class="dx-category-links">
            <p>代表記事</p>
            <ul>
              {category.articles.map((entry) => (
                <li>
                  <a href={url(entry.id)}>{entry.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {category.cases.length > 0 && (
          <div class="dx-category-links">
            <p>関連する実践事例</p>
            <ul>
              {category.cases.map((entry) => (
                <li>
                  <a href={url(entry.id)}>{entry.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    ))}
  </section>

  <section class="dx-ai-connection" aria-labelledby="dx-ai-heading">
    <h2 id="dx-ai-heading">AIとの接続</h2>
    <p>
      DXが「何を、なぜ変えるのか」を扱うのに対し、AIでは適用判断、責任境界、Knowledge、Evaluation、運用を具体的に設計します。実践事例では両者を同じ課題へ適用した過程を確認できます。
    </p>
    <nav class="topic-navigation" aria-label="関連する入口">
      <a href={url("ai")}>AIについて読む</a>
      <a href={url("cases")}>実践事例を見る</a>
    </nav>
  </section>
</Site>
