---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import PageHeader from "../components/PageHeader.astro";
import DomainThemeSection from "../components/DomainThemeSection.astro";
import { dxCategories, dxFeaturedArticles, dxIntroductionParagraphs } from "../lib/dx";
import { activeEntry } from "../lib/site";
const all = await getCollection("pages", activeEntry);
const categoryGroups = dxCategories.map((category) => ({
  ...category,
  articles: dxFeaturedArticles(all, category.id),
}));
const headings = dxCategories.map((category) => ({
  depth: 2,
  slug: category.id,
  text: category.title,
}));
---

<Site title="DX" section="dx" headings={headings}>
  <PageHeader alignHero navigationPath="dx" title="DX" eyebrow="DIGITAL TRANSFORMATION" />
  <p>
    技術を選ぶ前に、何を、なぜ変えるのかを考えます。
  </p>
  <p>
    価値から始め、仕事の流れ、既存システム、維持や終了、導入後の改善を見渡すための地図です。
  </p>
  <section class="dx-category-list" aria-labelledby="dx-themes-heading">
    <h2 id="dx-themes-heading">DXを考える{dxCategories.length}つのテーマ</h2>
    {categoryGroups.map((category) => (
      <DomainThemeSection
        {...category}
        path={`dx/${category.id}`}
        paragraphs={dxIntroductionParagraphs(category.summary)}
        domain="dx"
      />
    ))}
  </section>
</Site>
