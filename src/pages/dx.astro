---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import PageHeader from "../components/PageHeader.astro";
import ContentIndex from "../components/ContentIndex.astro";
import { publicEntry, url } from "../lib/site";
import { hasEntryPoint } from "../lib/entry-points";

const all = await getCollection("pages", publicEntry);
const entries = all
  .filter((entry) => hasEntryPoint(entry, "dx"))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "ja"));
---

<Site
  title="DX"
  section="dx"
  summary="AIを何のために使うのかを考えるために、価値・業務変革・システム企画を扱います。"
>
  <PageHeader
    title="DX"
    eyebrow="SURROUNDING DOMAIN"
    summary="AIを何のために使うのかを考えるために、価値・業務変革・システム企画を扱います。"
  />
  <p>
    Rosariumの主軸はAIです。DXは、技術導入を目的化せず、誰にどのような価値を生み出し、業務やサービスをどう変えるかを考える周辺領域として扱います。
  </p>
  <p class="domain-cross-link"><a href={url("ai")}>AIの入口を見る →</a></p>
  <section aria-labelledby="dx-articles-heading">
    <h2 id="dx-articles-heading">DXに関連する記事</h2>
    <ContentIndex entries={entries} showIcons={false} />
  </section>
</Site>
