---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import SeriesIndex from "../components/SeriesIndex.astro";
import { caseStudies } from "../lib/navigation";
import { publicEntry, url } from "../lib/site";
import PageHeader from "../components/PageHeader.astro";
import ThemeArticleIndex from "../components/ThemeArticleIndex.astro";
import { readingNavigation } from "../lib/reading";
const all = await getCollection("pages", publicEntry);
const themeGroups = readingNavigation(all, "cases");
---

<Site title="実践事例" section="cases" themeGroups={themeGroups}>
  <PageHeader title="実践事例" />
  <p>各事例が扱う課題、設計、到達点を確認し、必要な章へ進めます。</p>
  <ThemeArticleIndex groups={themeGroups} />
  {caseStudies.map((study) => (
    <section class="case-study-index">
      <SeriesIndex
        entry={all.find((e) => e.id === study.book)!}
        all={all}
        showCover={false}
        showIcons={false}
      >
        <div slot="details">
        <dl class="case-outcome" aria-label="課題から結果まで">
          <div>
            <dt>課題</dt>
            <dd>{study.challenge}</dd>
          </div>
          <div>
            <dt>設計</dt>
            <dd>{study.designSummary}</dd>
          </div>
          <div>
            <dt>結果</dt>
            <dd>{study.result}</dd>
          </div>
        </dl>
        </div>
      </SeriesIndex>
    </section>
  ))}
  <nav class="topic-navigation" aria-label="全体と公開物への入口">
    <a href={url("ai")}>AI</a>
    <a href={url("series")}>設計原則の連載</a>
  </nav>
</Site>
