---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import SeriesIndex from "../components/SeriesIndex.astro";
import { caseStudies } from "../lib/navigation";
import { publicEntry, url } from "../lib/site";
import PageHeader from "../components/PageHeader.astro";
const all = await getCollection("pages", publicEntry);
const caseGroups = [
  {
    id: "active-cases",
    title: "主要事例",
    description: "",
    studies: caseStudies.filter((study) =>
      ["recommended", "active"].includes(study.lifecycle),
    ),
  },
  {
    id: "obsolete-cases",
    title: "旧事例",
    description:
      "現在の推奨構成ではありませんが、当時の制約下での設計判断を参考として残しています。",
    studies: caseStudies.filter((study) =>
      ["reference", "obsolete"].includes(study.lifecycle),
    ),
  },
];
---

<Site title="実践事例" section="cases">
  <PageHeader title="実践事例" />
  <p>各事例が扱う課題、設計、到達点を確認し、必要な章へ進めます。</p>
  {caseGroups
    .filter((group) => group.studies.length > 0)
    .map((group) => (
      <section
        id={group.id}
        class:list={[
          "case-group",
          group.id === "obsolete-cases" && "case-group-obsolete",
        ]}
        aria-labelledby={`${group.id}-heading`}
      >
        <h2 id={`${group.id}-heading`}>{group.title}</h2>
        {group.description && (
          <p class="case-group-description">{group.description}</p>
        )}
        {group.studies.map((study) => (
          <div class="case-study-index">
            <SeriesIndex
              entry={all.find((e) => e.id === study.book)!}
              all={all}
              showCover={false}
              showIcons={false}
              heading="h3"
            >
              <div slot="details">
                <dl class="case-outcome" aria-label="課題から結果まで">
                  <div>
                    <dt>課題</dt>
                    <dd>{study.challenge}</dd>
                  </div>
                  <div>
                    <dt>設計</dt>
                    <dd>{study.designSummary}</dd>
                  </div>
                  <div>
                    <dt>結果</dt>
                    <dd>{study.result}</dd>
                  </div>
                </dl>
              </div>
            </SeriesIndex>
          </div>
        ))}
      </section>
    ))}
  <nav class="topic-navigation" aria-label="全体と公開物への入口">
    <a href={url("books")}>実務事例のBook一覧</a>
  </nav>
</Site>
