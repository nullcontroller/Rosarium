---
import Site from "../../layouts/Site.astro";
import { url } from "../../lib/site";

const career = url("career");
const canonical = new URL(career, Astro.site).toString();
---

<Site showRightSidebar={false}
  title="Careerをご覧ください"
  summary="仕事の考え方と経験はCareer、職歴・資格の詳細はLinkedInで確認できます。"
  canonical={canonical}
  noindex
  showLastUpdated={false}
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${career}`} />
  <script is:inline define:vars={{ career }}>
    location.replace(career);
  </script>
  <h1>Careerをご覧ください</h1>
  <p>
    仕事の考え方と経験の背景はCareerで紹介しています。詳細な職務プロフィールはCareerからLinkedInをご覧ください。
  </p>
  <p>
    <a href={career}>Careerへ移動する</a>
  </p>
</Site>
