---
import { getCollection, render } from "astro:content";
import Site from "../layouts/Site.astro";
import { splitRelatedContent, relatedTargets } from "../lib/related-content.mjs";
import RelatedPublications from "../components/RelatedPublications.astro";
import {
  layerPath,
  contentCategory,
  relatedPublications,
  topicLabel,
  designTopics,
  topicPublications,
  publicationStatus,
  publicationTiming,
  mathematicsReadingIds,
} from "../lib/navigation";
import ContentLink from "../components/ContentLink.astro";
import MarkdownBody from "../components/MarkdownBody.astro";
import { imageDimensions } from "../lib/image-metadata";
import { contentUseCases } from "../lib/use-cases";
import { formatDateJa, url, layerLabel, publicEntry } from "../lib/site";
import { iconForEntry, iconForTopic } from "../lib/icons";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ThemeArticleIndex from "../components/ThemeArticleIndex.astro";
import { readingNavigation, readingPathForEntry } from "../lib/reading";
import {
  contentEntryPoints,
  entryPointDefinitions,
} from "../lib/entry-points";
import { dxCategories, dxCategoryIdsForEntry } from "../lib/dx";
export async function getStaticPaths() {
  return (await getCollection("pages", publicEntry)).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const d = entry.data;
const content = splitRelatedContent(entry.rendered?.html || "");
const relatedLinks = relatedTargets(content.related, Astro.url.href);
const alreadyRelated = (path: string) => relatedLinks.has(new URL(url(path), Astro.url).href);
const primaryPath = d.section === "cases" ? "cases" : layerPath(d.layer);
const primaryLabel =
  d.section === "cases" ? "実践事例" : layerLabel(d.layer);
const { headings } = await render(entry);
const all = await getCollection("pages", publicEntry);
const series = d.series
  ? all
      .filter((e) => e.data.series === d.series)
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  : [];
const readingSequence = series.length
  ? series
  : d.layer === "ai-mathematics"
    ? mathematicsReadingIds
        .map((id) => all.find((item) => item.id === id))
        .filter((item): item is (typeof all)[number] => Boolean(item))
    : [];
const position = readingSequence.findIndex((e) => e.id === entry.id);
const previous = readingSequence[position - 1],
  next = readingSequence[position + 1];
const seriesPosition =
  series.length > 0
    ? (d.order ?? 0) === 0
      ? `現在位置：全体構成・全${series.length - 1}章`
      : `現在位置：第${d.order}章・全${series.length - 1}章`
    : undefined;
const coverDimensions = imageDimensions(
  d.cover ? "/Rosarium" + d.cover : undefined,
);
const related = all
  .filter(
    (e) =>
      e.id !== entry.id &&
      !alreadyRelated(e.id) &&
      !e.data.series &&
      e.data.layer === d.layer &&
      (d.design_topic
        ? e.data.design_topic === d.design_topic
        : e.data.section === d.section),
  )
  .slice(0, 3);
const purposes = contentUseCases(entry);
const timing = publicationTiming(entry);
const publicationState = publicationStatus(entry);
const entryPoints = contentEntryPoints(entry);
const dxTopics = dxCategoryIdsForEntry(entry)
  .map((id) => dxCategories.find((category) => category.id === id))
  .filter((category): category is (typeof dxCategories)[number] => Boolean(category));
const uniqueEntryPoints = entryPoints.filter((point) => !alreadyRelated(entryPointDefinitions[point].path));
const uniqueDxTopics = dxTopics.filter((category) => !alreadyRelated(`dx/${category.id}`));
const readingPath = readingPathForEntry(entry, all);
const themeGroups = readingPath
  ? series.length
    ? []
    : readingNavigation(all, readingPath, entry.id)
  : [];
const relatedPublicationEntries = d.layer === "ai-design"
  ? relatedPublications(all, d.design_topic).filter((item) => !alreadyRelated(item.id))
  : [];
const displayedIds = new Set([...related, ...relatedPublicationEntries].map((item) => item.id));
const endThemeGroups = themeGroups.map((group) => ({
  ...group,
  links: group.links.filter((link) => !displayedIds.has(link.id) && !alreadyRelated(link.id)),
})).filter((group) => group.links.length > 0);
const bookNavigation = series.length
  ? {
      title: d.series_title || series[0].data.title,
      items: series.map((item) => ({
        title:
          (item.data.order ?? 0) === 0
            ? "全体構成"
            : item.data.title,
        href: url(item.id),
        current: item.id === entry.id,
      })),
    }
  : undefined;
---

<Site
  title={d.title}
  summary={d.summary}
  canonical={d.canonical}
  ogType="article"
  publishedAt={d.published_at}
  lastUpdated={d.last_updated}
  showLastUpdated={false}
  section={primaryPath}
  headings={headings.map((heading) => ({ ...heading, text: heading.text.replace("Related Design Principles", "関連する設計原則").replace("Related Design", "関連する設計") }))}
  breadcrumbs={[
    { name: "庭", path: "" },
    { name: primaryLabel, path: primaryPath },
    ...(d.design_topic
      ? [
          {
            name: topicLabel(d.design_topic) || d.design_topic,
            path: "ai-design/" + d.design_topic,
          },
        ]
      : []),
    { name: d.title, path: entry.id },
  ]}
  themeGroups={themeGroups}
  bookNavigation={bookNavigation}
>
  <nav class="breadcrumb">
    <a href={url()}>庭</a> / <a href={url(primaryPath)}>{primaryLabel}</a>
    {d.design_topic && (
      <>
        {" "}
        /{" "}
        <a href={url("ai-design/" + d.design_topic)}>
          {topicLabel(d.design_topic)}
        </a>
      </>
    )}
  </nav>
  <article data-pagefind-body>
    <header class="document-header">
      <p class="eyebrow">
        <span data-pagefind-meta="category">{contentCategory(entry)}</span> /{" "}
        <span data-pagefind-meta="layer">{layerLabel(d.layer)}</span> / {d.kind}
      </p>
      <div class="document-title-row">
        <Icon name={iconForEntry(entry)} size="page" />
        <h1 data-pagefind-meta="title">{d.title}</h1>
      </div>
      <span hidden data-pagefind-meta="icon">{iconForEntry(entry)}</span>
      {d.summary && (
        <p class="lead" data-pagefind-meta="summary">
          {d.summary}
        </p>
      )}
      <p class="meta">
        <span hidden data-pagefind-meta="status">公開</span>
        {(d.publication_format || d.layer === "publication") && (
          <>
            {publicationState && <span>状態：{publicationState}</span>}
            <span>
              {timing.label}：{timing.datetime ? (
                <time datetime={timing.datetime}>{timing.value}</time>
              ) : (
                timing.value
              )}
            </span>
          </>
        )}
        <span class="content-last-updated">
          最終更新：<time datetime={d.last_updated}>{formatDateJa(d.last_updated)}</time>
        </span>
        <span hidden data-pagefind-meta="last_updated">{d.last_updated}</span>
      </p>
      {(d.publication_format || d.layer === "publication") && (
        <span hidden data-pagefind-meta="publication">{timing.value}</span>
      )}
      {d.update_note && (
        <p class="update-note">今回の更新：{d.update_note}</p>
      )}
      <p class="tags" data-pagefind-meta="tags">
        {d.tags.join(" / ")}
      </p>
      <span hidden data-pagefind-meta="entry_point">{entryPoints.join(" ")}</span>
      {purposes.length > 0 && (
        <p class="content-purpose" data-pagefind-meta="use_case">
          <span>読む目的：</span>{" "}
          {purposes.map((purpose, index) => (
            <>
              {index > 0 && " / "}
              <span>{purpose.shortTitle}</span>
            </>
          ))}
        </p>
      )}
    </header>
    {d.cover && d.show_cover && (
      <img
        class="book-cover"
        src={"/Rosarium" + d.cover}
        alt={d.cover_alt || d.title + " 表紙"}
        width={coverDimensions?.width || 180}
        height={coverDimensions?.height}
        loading="lazy"
        decoding="async"
      />
    )}
    {seriesPosition && <p class="series-position-inline">{seriesPosition}</p>}
    <div class="prose">
      <MarkdownBody html={content.body} />
    </div>
  </article>
  {readingSequence.length > 0 && (
    <nav
      class="pagination"
      aria-label={series.length ? "前後の章" : "AI理論の前後ページ"}
    >
      {previous ? (
        <div>
          <p>← 前のページ</p>
          <ContentLink entry={previous} heading="p" />
        </div>
      ) : (
        <span />
      )}
      {next && (
        <div>
          <p>次のページ →</p>
          <ContentLink entry={next} heading="p" />
        </div>
      )}
    </nav>
  )}
  <section class="content-related" aria-label="関連する内容" data-related-content>
    {content.principles && <div class="prose"><MarkdownBody html={content.principles} /></div>}
  {designTopics.some(([key]) =>
    topicPublications[key]?.includes(series[0]?.id || entry.id) && !alreadyRelated("ai-design/" + key),
  ) && (
    <section>
      <SectionHeading icon="ai-design" title="関連する設計" />
      <ul class="related-design-list">
        {designTopics
          .filter(([key]) =>
            topicPublications[key]?.includes(series[0]?.id || entry.id) && !alreadyRelated("ai-design/" + key),
          )
          .map(([key, title, summary]) => (
            <li class="icon-entry">
              <Icon name={iconForTopic(key)} size="list" />
              <p><a href={url("ai-design/" + key)}>{title}</a> — {summary}</p>
            </li>
          ))}
      </ul>
    </section>
  )}
    {content.afterDesign && <div class="prose"><MarkdownBody html={content.afterDesign} /></div>}
  {d.layer === "ai-design" && (
    <RelatedPublications entries={relatedPublicationEntries} />
  )}
  {d.source?.type === "zenn" && d.section === "cases" && (
    <p>
      <a href={url("cases")}>実践事例 — 適用テーマ・設計原則から読む</a>
    </p>
  )}
  {related.length > 0 && (
    <section class="related">
      <SectionHeading icon="arrow" title="次に読む" />
      <ul>
        {related.map((e) => (
          <li>
            <ContentLink entry={e} heading="h3" showEntryPoints={false} />
          </li>
        ))}
      </ul>
    </section>
  )}
      {uniqueEntryPoints.length > 0 && <nav class="content-entry-points" aria-label="この記事の入口">
        <span>入口：</span>
        {uniqueEntryPoints.map((entryPoint) => (
          <a href={url(entryPointDefinitions[entryPoint].path)}>{entryPointDefinitions[entryPoint].label}</a>
        ))}
      </nav>}
      {uniqueDxTopics.length > 0 && (
        <nav class="content-dx-topics" aria-label="関連するDXテーマ">
          <span>DXテーマ：</span>
          {uniqueDxTopics.map((category) => (
            <a href={url(`dx/${category.id}`)}>{category.title}</a>
          ))}
        </nav>
      )}

  {endThemeGroups.length > 0 && <ThemeArticleIndex groups={endThemeGroups} />}
  <nav class="content-end-nav" aria-label="読み終えた後のリンク">
    <a href={`${url()}#recent-growth-heading`}>最近の更新を見る</a>
  </nav>
  </section>
</Site>
