---
import { getCollection, render } from "astro:content";
import Site from "../layouts/Site.astro";
import { supportPocLegacyFragments } from "../data/support-poc-fragments";
import { splitRelatedContent, caseEvidenceLinks } from "../lib/related-content.mjs";
import {
  layerPath,
  bookChapterNumber,
  contentCategory,
  topicLabel,
  publicationStatus,
  publicationTiming,
  caseStudies,
} from "../lib/navigation";
import ContentLink from "../components/ContentLink.astro";
import MarkdownBody from "../components/MarkdownBody.astro";
import { imageDimensions } from "../lib/image-metadata";
import { contentUseCases } from "../lib/use-cases";
import { bookChapterLegacyFragments } from "../data/book-chapter-fragments";
import ContentHistory from "../components/ContentHistory.astro";
import { url, layerLabel, publicEntry, publishedEntry } from "../lib/site";
import LifecycleNote from "../components/LifecycleNote.astro";
import { iconForEntry } from "../lib/icons";
import Icon from "../components/Icon.astro";
import {
  contentEntryPoints,
} from "../lib/entry-points";
export async function getStaticPaths() {
  return (await getCollection("pages", (entry) => publishedEntry(entry) && !["cases/ai-technical-investigation/investigation-principles", "software-engineering/ai-technical-investigation-design", "evaluation-hitl/customer-support-qa-poc", "practices/ai-adoption-and-effective-use", "practices/ai-education-principles", "practices/transferring-ai-practices", "essays/what-not-to-build-with-ai", "architecture/agents-tools-and-workflows", "foundations/generation-and-acceptance", "cases/understanding-systems-as-capability", "software-engineering/ai-driven-development", "software-engineering/code-generation-boundaries", "software-engineering/code-generation-and-work-design"].includes(entry.id))).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const legacyPocFragments = ["cases/customer-support-ai-dx/poc-effect-evaluation", "cases/customer-support-ai-dx/poc-metadata-improvement"].includes(entry.id)
  ? Object.fromEntries(Object.entries(supportPocLegacyFragments).map(([alias, target]) => {
      const [path, fragment] = target.split("#");
      return [alias, url(path) + "#" + encodeURIComponent(fragment)];
    }))
  : Object.fromEntries(Object.entries(bookChapterLegacyFragments[entry.id] ?? {}).map(([alias, target]) => {
      const [path, fragment] = target.split("#");
      return [alias, url(path) + "#" + encodeURIComponent(fragment)];
    }));

const d = entry.data;
const isBookIntroduction = entry.id === "cases/customer-support-ai-dx";
const content = splitRelatedContent(entry.rendered?.html || "");
const primaryPath = d.section === "cases" ? "cases" : layerPath(d.layer);
const primaryLabel =
  d.section === "cases" ? "実践事例" : layerLabel(d.layer);
const { headings } = await render(entry);
const all = await getCollection("pages", publicEntry);
const activeIds = new Set(all.filter(item => item.data.lifecycle === "active").map(item => item.id));
const evidenceLinks = caseEvidenceLinks(entry.id, content.body, Astro.url, caseStudies.filter(study => activeIds.has(study.book)), activeIds)
  .map((id: string) => all.find(item => item.id === id)!);
const series = d.series
  ? all
      .filter((e) => e.data.series === d.series)
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  : [];
const readingSequence = series;
const position = readingSequence.findIndex((e) => e.id === entry.id);
const previous = readingSequence[position - 1],
  next = readingSequence[position + 1];
const chapterCount = series.filter((item) => (item.data.order ?? 0) > 0).length;
const chapterNumber = bookChapterNumber(entry);
const seriesPosition = series.length > 0
  ? `現在位置：${(d.order ?? 0) === 0 ? "全体構成" : `第${String(chapterNumber).padStart(2, "0")}章`}・全${chapterCount}章`
  : undefined;
const coverDimensions = imageDimensions(
  d.cover ? d.cover : undefined,
);
const purposes = contentUseCases(entry);
const timing = publicationTiming(entry);
const publicationState = publicationStatus(entry);
const entryPoints = contentEntryPoints(entry);
const bookNavigation = series.length
  ? {
      title: d.series_title || series[0].data.title,
      chapterCount,
      items: series.map((item) => ({
        title:
          (item.data.order ?? 0) === 0
            ? "全体構成"
            : item.data.title,
        href: url(item.id),
        current: item.id === entry.id,
      })),
    }
  : undefined;
---

<Site
  title={d.title}
  showRightSidebar={d.layer !== "reference"}
  summary={d.summary}
  canonical={d.canonical}
  ogType="article"
  noindex={d.lifecycle === "retired"}
  internalSearch
  searchLifecycle={d.lifecycle}
  publishedAt={d.published_at}
  lastUpdated={d.last_updated}
  showLastUpdated={false}
  section={primaryPath}
  headings={headings.filter((heading) => content.body.includes(`id="${heading.slug}"`)).map((heading) => ({ ...heading, text: heading.text.replace("Related Design Principles", "関連する設計原則").replace("Related Design", "関連する設計") }))}
  breadcrumbs={[
    { name: "庭", path: "" },
    { name: primaryLabel, path: primaryPath },
    ...(d.design_topic
      ? [
          {
            name: topicLabel(d.design_topic) || d.design_topic,
            path: "ai-design/" + d.design_topic,
          },
        ]
      : []),
    { name: d.title, path: entry.id },
  ]}
  bookNavigation={bookNavigation}
>
  <nav class="breadcrumb">
    <a href={url()}>庭</a> / <a href={url(primaryPath)}>{primaryLabel}</a>
    {d.design_topic && (
      <>
        {" "}
        /{" "}
        <a href={url("ai-design/" + d.design_topic)}>
          {topicLabel(d.design_topic)}
        </a>
      </>
    )}
  </nav>
  <article data-lifecycle={d.lifecycle} data-pagefind-body>
    <header class="document-header">
      <p class="eyebrow">
        <span hidden data-pagefind-meta="content_kind">{d.kind === "case" || d.layer === "case" || d.section === "cases" ? "事例" : "記事"}</span>
        <span data-pagefind-meta="category">{contentCategory(entry)}</span> /{" "}
        <span data-pagefind-meta="layer">{layerLabel(d.layer)}</span> / {d.kind}
      </p>
      <div class="document-title-row">
        <Icon name={iconForEntry(entry)} size="page" />
        <h1 data-pagefind-meta="title">{d.title}</h1>
      </div>
      <span hidden data-pagefind-meta="icon">{iconForEntry(entry)}</span>
      {d.summary && (
        <p class="lead" hidden={isBookIntroduction} data-pagefind-meta="summary">
          {d.summary}
        </p>
      )}
      <p class="meta">
        <span hidden data-pagefind-meta="status">公開</span>
        {publicationState && <span>状態：{publicationState}</span>}
        <ContentHistory lastUpdated={d.last_updated} />
        <span hidden data-pagefind-meta="last_updated">{d.last_updated}</span>
      </p>
      {(d.publication_format || d.layer === "publication") && (
        <span hidden data-pagefind-meta="publication">{timing.value}</span>
      )}
      <p class="tags" data-pagefind-meta="tags">
        {d.tags.join(" / ")}
      </p>
      <span hidden data-pagefind-meta="entry_point">{entryPoints.join(" ")}</span>
      {purposes.length > 0 && (
        <p class="content-purpose" data-pagefind-meta="use_case">
          <span>読む目的：</span>{" "}
          {purposes.map((purpose, index) => (
            <>
              {index > 0 && " / "}
              <span>{purpose.shortTitle}</span>
            </>
          ))}
        </p>
      )}
    </header>
    {entry.id !== "cases/system-understanding" && <LifecycleNote lifecycle={d.lifecycle} reason={d.lifecycle_reason} />}
    {d.cover && d.show_cover && (
      <img
        class="book-cover"
        src={d.cover}
        alt={d.cover_alt || d.title + " 表紙"}
        width={coverDimensions?.width || 180}
        height={coverDimensions?.height}
        loading="lazy"
        decoding="async"
      />
    )}
    {seriesPosition && <p class="series-position-inline">{seriesPosition}</p>}
    <div class="prose" data-book-introduction={isBookIntroduction ? "" : undefined} data-toc-exclude={isBookIntroduction ? "" : undefined} id={isBookIntroduction ? "このbookについて" : undefined}>
      <MarkdownBody html={content.body} />
    </div>
    {evidenceLinks.length > 0 && <section class="case-knowledge-links" aria-labelledby="evidence-links-heading">
      <h2 id="evidence-links-heading">{d.section === "cases" ? "この事例で使う設計原則" : "この原則を使う実践事例"}</h2>
      <ul>{evidenceLinks.map(item => <li><a href={url(item.id)}>{item.data.title}</a></li>)}</ul>
    </section>}
  </article>
  {readingSequence.length > 0 && (
    <nav
      class="pagination"
      aria-label={series.length ? "前後の章" : "AI理論の前後ページ"}
    >
      {previous ? (
        <div>
          <p>前のページ</p>
          <ContentLink entry={previous} heading="p" />
        </div>
      ) : (
        <span />
      )}
      {next && (
        <div>
          <p>次のページ</p>
          <ContentLink entry={next} heading="p" />
        </div>
      )}
    </nav>
  )}
  {Object.keys(legacyPocFragments).length > 0 && <script is:inline define:vars={{ legacyPocFragments }}>
    function followLegacyPocFragment() {
      let alias;
      try { alias = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      if (Object.hasOwn(legacyPocFragments, alias)) location.replace(legacyPocFragments[alias]);
    }
    followLegacyPocFragment();
    window.addEventListener("hashchange", followLegacyPocFragment);
  </script>}
</Site>
