---
import { getCollection, render } from "astro:content";
import { isDraftPreview } from "../lib/draft-preview.mjs";
import { selectedDesignStudies } from "../data/design-studies.mjs";
import Site from "../layouts/Site.astro";
import { supportPocLegacyFragments } from "../data/support-poc-fragments";
import { splitRelatedContent, caseEvidenceLinks } from "../lib/related-content.mjs";
import {
  entryPrimaryPath,
  bookChapterNumber,
  contentCategory,
  contentType,
  publicationStatus,
  publicationTiming,
  caseStudies,
} from "../lib/navigation";
import ContentLink from "../components/ContentLink.astro";
import MarkdownBody from "../components/MarkdownBody.astro";
import { imageDimensions } from "../lib/image-metadata";
import { contentUseCases } from "../lib/use-cases";
import { bookChapterLegacyFragments } from "../data/book-chapter-fragments";
import ContentHistory from "../components/ContentHistory.astro";
import { url, layerLabel, publicEntry, publishedEntry, formatDateJa } from "../lib/site";
import LifecycleNote from "../components/LifecycleNote.astro";
import { iconForEntry } from "../lib/icons";
import Icon from "../components/Icon.astro";
import {
  contentEntryPoints,
} from "../lib/entry-points";
export async function getStaticPaths() {
  return (await getCollection("pages", (entry) => (publishedEntry(entry) || isDraftPreview(entry, process.env.ROSARIUM_DRAFT_PREVIEW)) && !["cases/ai-technical-investigation/investigation-principles", "software-engineering/ai-technical-investigation-design", "evaluation-hitl/customer-support-qa-poc", "practices/ai-adoption-and-effective-use", "practices/ai-education-principles", "practices/transferring-ai-practices", "essays/what-not-to-build-with-ai", "architecture/agents-tools-and-workflows", "foundations/generation-and-acceptance", "cases/understanding-systems-as-capability", "software-engineering/ai-driven-development", "software-engineering/code-generation-boundaries", "software-engineering/code-generation-and-work-design"].includes(entry.id))).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const legacyPocFragments = ["cases/customer-support-ai-dx/poc-effect-evaluation", "cases/customer-support-ai-dx/poc-metadata-improvement"].includes(entry.id)
  ? Object.fromEntries(Object.entries(supportPocLegacyFragments).map(([alias, target]) => {
      const [path, fragment] = target.split("#");
      return [alias, url(path) + "#" + encodeURIComponent(fragment)];
    }))
  : Object.fromEntries(Object.entries(bookChapterLegacyFragments[entry.id] ?? {}).map(([alias, target]) => {
      const [path, fragment] = target.split("#");
      return [alias, url(path) + "#" + encodeURIComponent(fragment)];
    }));

const d = entry.data;
// Real-work labels are limited to the existing evidence registry and its chapters.
const type = contentType(entry);
const articleType = type === "実務事例" || type === "仮想設計" ? `事例 / ${type}` : type;
const isBookIntroduction = entry.id === "cases/customer-support-ai-dx";
const content = splitRelatedContent(entry.rendered?.html || "");
// Placement review only: ordinary builds retain the published Book unchanged.
if (isBookIntroduction && process.env.ROSARIUM_DRAFT_PREVIEW) {
  const entrance = `<section data-design-studies-preview><h2>この事例を起点に設計を考える</h2><p>実務事例で得た知見を出発点に、異なる制約や追加要件を設定した仮想設計ケーススタディです。実際の追加開発や本番運用の実績とは区別します。</p><p><a href="${url("cases/design-studies")}">発展ケーススタディをテーマから探す →</a></p></section>`;
  content.body = content.body.replace(/(?=<h2[^>]*>詳細の読み方<\/h2>)/, entrance);
}
const studyLinks = selectedDesignStudies(process.env.ROSARIUM_DRAFT_PREVIEW)
  .filter(study => study.chapters.some(chapter => entry.id === `cases/customer-support-ai-dx/${chapter}`));
if (studyLinks.length) {
  content.body += `<section data-design-studies-preview><h2>条件を変えた設計検討</h2><p>実務の追加実績とは区別した仮想設計です。</p><ul>${studyLinks.map(study => `<li><a href="${url(study.id)}">${study.question}</a></li>`).join("")}</ul></section>`;
}
const primaryPath = entryPrimaryPath(entry);
const { headings } = await render(entry);
const all = await getCollection("pages", publicEntry);
const activeIds = new Set(all.filter(item => item.data.lifecycle === "active").map(item => item.id));
const evidenceLinks = caseEvidenceLinks(entry.id, content.body, Astro.url, caseStudies.filter(study => activeIds.has(study.book)), activeIds)
  .map((id: string) => all.find(item => item.id === id)!);
const series = d.series
  ? (await getCollection("pages", item => publicEntry(item) || isDraftPreview(item, process.env.ROSARIUM_DRAFT_PREVIEW)))
      .filter((e) => e.data.series === d.series)
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  : [];
const readingSequence = series;
const isSerial = series.some(item => item.data.publication_format === "series" && item.data.kind === "essay" && item.data.order === 0);
const seriesIntroduction = series.find(item => item.data.order === 0);
const position = readingSequence.findIndex((e) => e.id === entry.id);
const previous = isSerial ? series.find(item => item.data.order === (d.order ?? 0) - 1) : readingSequence[position - 1],
  next = isSerial ? series.find(item => item.data.order === (d.order ?? 0) + 1) : readingSequence[position + 1];
const chapterCount = isSerial ? Math.max(...series.map(item => item.data.order ?? 0)) : series.filter((item) => (item.data.order ?? 0) > 0).length;
const chapterNumber = bookChapterNumber(entry);
const seriesPosition = series.length > 0
  ? isSerial ? `${d.series_title}：${d.order === 0 ? "シリーズ一覧" : `第${d.order}回`}・全${chapterCount}回` : `現在位置：${(d.order ?? 0) === 0 ? "全体構成" : `第${String(chapterNumber).padStart(2, "0")}章`}・全${chapterCount}章`
  : undefined;
const coverDimensions = imageDimensions(
  d.cover ? d.cover : undefined,
);
const purposes = contentUseCases(entry);
const timing = publicationTiming(entry);
const publicationState = publicationStatus(entry);
const entryPoints = contentEntryPoints(entry);
const bookNavigation = series.length
  ? {
      title: d.series_title || series[0].data.title,
      chapterCount,
      tocLabel: isSerial ? `この連載の目次（全${chapterCount}回）` : undefined,
      items: series.map((item) => ({
        title:
          (item.data.order ?? 0) === 0
            ? "全体構成"
            : isSerial ? `第${item.data.order}回：${item.data.title}` : item.data.title,
        href: url(item.id),
        current: item.id === entry.id,
      })),
    }
  : undefined;
---

<Site
  title={d.title}
  showRightSidebar={d.layer !== "reference"}
  summary={d.summary}
  canonical={d.canonical}
  ogType="article"
  noindex={d.lifecycle === "retired" || d.status === "draft"}
  internalSearch={d.status !== "draft"}
  searchLifecycle={d.lifecycle}
  publishedAt={d.published_at}
  lastUpdated={d.last_updated}
  showLastUpdated={false}
  section={primaryPath}
  headings={headings.filter((heading) => content.body.includes(`id="${heading.slug}"`)).map((heading) => ({ ...heading, text: heading.text.replace("Related Design Principles", "関連する設計原則").replace("Related Design", "関連する設計") }))}
  bookNavigation={bookNavigation}
>
  {d.status === "draft" && <p class="meta" role="note">レビュー用初稿：内容・公開可否は所有者の確認前です。</p>}
  <article data-lifecycle={d.lifecycle} data-pagefind-body>
    <header class="document-header">
      <p class="eyebrow">
        <span hidden data-pagefind-meta="content_kind">{type}</span>
        <span hidden data-pagefind-meta="category">{contentCategory(entry)}</span>
        <span hidden data-pagefind-meta="layer">{layerLabel(d.layer)}</span>
        <span>{articleType}</span>
      </p>
      <div class="document-title-row">
        <Icon name={iconForEntry(entry)} size="page" />
        <h1 data-pagefind-meta="title">{d.title}</h1>
      </div>
      <span hidden data-pagefind-meta="icon">{iconForEntry(entry)}</span>
      {d.summary && (
        <p class="lead" hidden={isBookIntroduction} data-pagefind-meta="summary">
          {d.summary}
        </p>
      )}
      <p class="meta">
        <span hidden data-pagefind-meta="status">公開</span>
        {publicationState && <span hidden={publicationState === "公開"}>状態：{publicationState}</span>}
        <ContentHistory lastUpdated={d.last_updated} />
        <span hidden data-pagefind-meta="last_updated">{d.last_updated}</span>
      </p>
      {d.status === "draft" && d.published_at && <p class="meta" data-publication-planned>公開予定：<time datetime={d.published_at}>{formatDateJa(d.published_at)}</time></p>}
      {(d.publication_format || d.layer === "publication") && (
        <span hidden data-pagefind-meta="publication">{timing.value}</span>
      )}
      <p class="tags" hidden data-pagefind-meta="tags">
        {d.tags.join(" / ")}
      </p>
      <span hidden data-pagefind-meta="entry_point">{entryPoints.join(" ")}</span>
      {purposes.length > 0 && (
        <p class="content-purpose" hidden data-pagefind-meta="use_case">
          <span>読む目的：</span>{" "}
          {purposes.map((purpose, index) => (
            <>
              {index > 0 && " / "}
              <span>{purpose.shortTitle}</span>
            </>
          ))}
        </p>
      )}
    </header>
    {entry.id !== "cases/system-understanding" && <LifecycleNote lifecycle={d.lifecycle} reason={d.lifecycle_reason} />}
    {d.cover && d.show_cover && (
      <img
        class="book-cover"
        src={d.cover}
        alt={d.cover_alt || d.title + " 表紙"}
        width={coverDimensions?.width || 180}
        height={coverDimensions?.height}
        loading="lazy"
        decoding="async"
      />
    )}
    {seriesPosition && <p class="series-position-inline">{seriesPosition}</p>}
    {isSerial && seriesIntroduction && d.order !== 0 && <p><a href={url(seriesIntroduction.id)}>シリーズ一覧へ</a></p>}
    <div class="prose" data-book-introduction={isBookIntroduction ? "" : undefined} data-toc-exclude={isBookIntroduction ? "" : undefined} id={isBookIntroduction ? "このbookについて" : undefined}>
      <MarkdownBody html={content.body} />
    </div>
    {evidenceLinks.length > 0 && <section class="case-knowledge-links" aria-labelledby="evidence-links-heading">
      <h2 id="evidence-links-heading">{d.section === "cases" ? "この事例で使う設計原則" : "この原則を使う事例"}</h2>
      <ul>{evidenceLinks.map(item => <li><a href={url(item.id)}>{item.data.title}</a></li>)}</ul>
    </section>}
  </article>
  {readingSequence.length > 0 && (
    <nav
      class="pagination"
      aria-label={series.length ? "前後の章" : "AI理論の前後ページ"}
    >
      {previous ? (
        <div>
          <p>{isSerial ? "前回" : "前のページ"}</p>
          <ContentLink entry={previous} heading="p" />
        </div>
      ) : (
        <span />
      )}
      {next && (
        <div>
          <p>{isSerial ? "次回" : "次のページ"}</p>
          <ContentLink entry={next} heading="p" />
        </div>
      )}
    </nav>
  )}
  {Object.keys(legacyPocFragments).length > 0 && <script is:inline define:vars={{ legacyPocFragments }}>
    function followLegacyPocFragment() {
      let alias;
      try { alias = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      if (Object.hasOwn(legacyPocFragments, alias)) location.replace(legacyPocFragments[alias]);
    }
    followLegacyPocFragment();
    window.addEventListener("hashchange", followLegacyPocFragment);
  </script>}
</Site>

<style>
  .document-header > .eyebrow { order: 0; }
  .document-header > .document-title-row { order: 1; }
</style>
