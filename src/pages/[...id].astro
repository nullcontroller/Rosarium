---
import { getCollection, render } from "astro:content";
import Site from "../layouts/Site.astro";
import { splitRelatedContent } from "../lib/related-content.mjs";
import {
  layerPath,
  bookChapterNumber,
  contentCategory,
  topicLabel,
  publicationStatus,
  publicationTiming,
} from "../lib/navigation";
import ContentLink from "../components/ContentLink.astro";
import MarkdownBody from "../components/MarkdownBody.astro";
import { imageDimensions } from "../lib/image-metadata";
import { contentUseCases } from "../lib/use-cases";
import { formatDateJa, url, layerLabel, publicEntry, publishedEntry } from "../lib/site";
import ContentHistory from "../components/ContentHistory.astro";
import LifecycleNote from "../components/LifecycleNote.astro";
import { iconForEntry } from "../lib/icons";
import Icon from "../components/Icon.astro";
import {
  contentEntryPoints,
} from "../lib/entry-points";
export async function getStaticPaths() {
  return (await getCollection("pages", (entry) => publishedEntry(entry) && !["software-engineering/code-generation-boundaries", "software-engineering/code-generation-and-work-design"].includes(entry.id))).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const d = entry.data;
const content = splitRelatedContent(entry.rendered?.html || "");
const primaryPath = d.section === "cases" ? "cases" : layerPath(d.layer);
const primaryLabel =
  d.section === "cases" ? "実践事例" : layerLabel(d.layer);
const { headings } = await render(entry);
const all = await getCollection("pages", publicEntry);
const series = d.series
  ? all
      .filter((e) => e.data.series === d.series)
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  : [];
const readingSequence = series;
const position = readingSequence.findIndex((e) => e.id === entry.id);
const previous = readingSequence[position - 1],
  next = readingSequence[position + 1];
const chapterCount = series.filter((item) => bookChapterNumber(item) > 0).length;
const chapterNumber = bookChapterNumber(entry);
const seriesPosition = series.length > 0
  ? `現在位置：${(d.order ?? 0) === 0 ? "全体構成" : chapterNumber === 0 ? "導入" : `第${chapterNumber}章`}・全${chapterCount}章`
  : undefined;
const coverDimensions = imageDimensions(
  d.cover ? "/Rosarium" + d.cover : undefined,
);
const purposes = contentUseCases(entry);
const timing = publicationTiming(entry);
const publicationState = publicationStatus(entry);
const entryPoints = contentEntryPoints(entry);
const bookNavigation = series.length
  ? {
      title: d.series_title || series[0].data.title,
      chapterCount,
      items: series.map((item) => ({
        title:
          (item.data.order ?? 0) === 0
            ? "全体構成"
            : item.data.title,
        href: url(item.id),
        current: item.id === entry.id,
      })),
    }
  : undefined;
---

<Site
  title={d.title}
  showRightSidebar={d.layer !== "reference"}
  summary={d.summary}
  canonical={d.canonical}
  ogType="article"
  noindex={d.lifecycle === "retired"}
  internalSearch
  searchLifecycle={d.lifecycle}
  publishedAt={d.published_at}
  lastUpdated={d.last_updated}
  showLastUpdated={false}
  section={primaryPath}
  headings={headings.filter((heading) => content.body.includes(`id="${heading.slug}"`)).map((heading) => ({ ...heading, text: heading.text.replace("Related Design Principles", "関連する設計原則").replace("Related Design", "関連する設計") }))}
  breadcrumbs={[
    { name: "庭", path: "" },
    { name: primaryLabel, path: primaryPath },
    ...(d.design_topic
      ? [
          {
            name: topicLabel(d.design_topic) || d.design_topic,
            path: "ai-design/" + d.design_topic,
          },
        ]
      : []),
    { name: d.title, path: entry.id },
  ]}
  bookNavigation={bookNavigation}
>
  <nav class="breadcrumb">
    <a href={url()}>庭</a> / <a href={url(primaryPath)}>{primaryLabel}</a>
    {d.design_topic && (
      <>
        {" "}
        /{" "}
        <a href={url("ai-design/" + d.design_topic)}>
          {topicLabel(d.design_topic)}
        </a>
      </>
    )}
  </nav>
  <article data-lifecycle={d.lifecycle} data-pagefind-body>
    <header class="document-header">
      <p class="eyebrow">
        <span hidden data-pagefind-meta="content_kind">{d.kind === "case" || d.layer === "case" || d.section === "cases" ? "事例" : "記事"}</span>
        <span data-pagefind-meta="category">{contentCategory(entry)}</span> /{" "}
        <span data-pagefind-meta="layer">{layerLabel(d.layer)}</span> / {d.kind}
      </p>
      <div class="document-title-row">
        <Icon name={iconForEntry(entry)} size="page" />
        <h1 data-pagefind-meta="title">{d.title}</h1>
      </div>
      <span hidden data-pagefind-meta="icon">{iconForEntry(entry)}</span>
      {d.summary && (
        <p class="lead" data-pagefind-meta="summary">
          {d.summary}
        </p>
      )}
      <p class="meta">
        <span hidden data-pagefind-meta="status">公開</span>
        {(d.publication_format || d.layer === "publication") && (
          <>
            {publicationState && <span>状態：{publicationState}</span>}
            <span>
              {timing.label}：{timing.datetime ? (
                <time datetime={timing.datetime}>{timing.value}</time>
              ) : (
                timing.value
              )}
            </span>
          </>
        )}
        <span class="content-last-updated">
          最終更新：<time datetime={d.last_updated}>{formatDateJa(d.last_updated)}</time>
        </span>
        <span hidden data-pagefind-meta="last_updated">{d.last_updated}</span>
      </p>
      {(d.publication_format || d.layer === "publication") && (
        <span hidden data-pagefind-meta="publication">{timing.value}</span>
      )}
      {d.layer !== "reference" && <ContentHistory id={entry.id} data={d} />}
      <p class="tags" data-pagefind-meta="tags">
        {d.tags.join(" / ")}
      </p>
      <span hidden data-pagefind-meta="entry_point">{entryPoints.join(" ")}</span>
      {purposes.length > 0 && (
        <p class="content-purpose" data-pagefind-meta="use_case">
          <span>読む目的：</span>{" "}
          {purposes.map((purpose, index) => (
            <>
              {index > 0 && " / "}
              <span>{purpose.shortTitle}</span>
            </>
          ))}
        </p>
      )}
    </header>
    {entry.id !== "cases/system-understanding" && <LifecycleNote lifecycle={d.lifecycle} reason={d.lifecycle_reason} />}
    {d.cover && d.show_cover && (
      <img
        class="book-cover"
        src={"/Rosarium" + d.cover}
        alt={d.cover_alt || d.title + " 表紙"}
        width={coverDimensions?.width || 180}
        height={coverDimensions?.height}
        loading="lazy"
        decoding="async"
      />
    )}
    {seriesPosition && <p class="series-position-inline">{seriesPosition}</p>}
    <div class="prose">
      <MarkdownBody html={content.body} />
    </div>
  </article>
  {readingSequence.length > 0 && (
    <nav
      class="pagination"
      aria-label={series.length ? "前後の章" : "AI理論の前後ページ"}
    >
      {previous ? (
        <div>
          <p>前のページ</p>
          <ContentLink entry={previous} heading="p" />
        </div>
      ) : (
        <span />
      )}
      {next && (
        <div>
          <p>次のページ</p>
          <ContentLink entry={next} heading="p" />
        </div>
      )}
    </nav>
  )}
</Site>
