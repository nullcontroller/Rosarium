---
import Site from "../layouts/Site.astro";
import { url } from "../lib/site";

const reading = url("ai");
const canonical = new URL(reading, Astro.site).toString();
---

<Site showRightSidebar={false}
  title="AI・数理をご覧ください"
  summary="AIの数学的・計算的基礎に関する記事をご覧ください。"
  canonical={canonical}
  noindex
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${reading}`} />
  <script is:inline define:vars={{ reading }}>
    location.replace(reading);
  </script>
  <h1>AI・数理をご覧ください</h1>
  <p>AIの数学的・計算的基礎に関する記事をご覧ください。</p>
  <p><a href={reading}>AI・数理へ移動する</a></p>
</Site>
