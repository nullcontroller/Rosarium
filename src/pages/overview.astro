---
import Site from "../layouts/Site.astro";
import { url } from "../lib/site";

const reading = url("ai");
const canonical = new URL(reading, Astro.site).toString();
---

<Site
  title="AIへ統合しました"
  summary="全体目次の役割はAIの入口へ統合しました。"
  canonical={canonical}
  noindex
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${reading}`} />
  <script is:inline define:vars={{ reading }}>
    location.replace(reading);
  </script>
  <h1>AIへ統合しました</h1>
  <p>全体目次の役割はAIの入口へ統合しました。</p>
  <p><a href={reading}>AIへ移動する</a></p>
</Site>
