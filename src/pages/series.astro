---
import Site from "../layouts/Site.astro";
import { url } from "../lib/site";
const destination = url("dx/business-transformation");
const canonical = new URL(destination, Astro.site).toString();
---

<Site showRightSidebar={false} title="業務変革へ統合しました" summary="一覧の役割は業務変革へ統合しました。" canonical={canonical} noindex showLastUpdated={false}>
  <meta slot="head" http-equiv="refresh" content={"0;url=" + destination} />
  <script is:inline define:vars={{ destination }}>location.replace(destination);</script>
  <h1>業務変革へ統合しました</h1>
  <p><a href={destination}>業務変革へ移動する</a></p>
</Site>
