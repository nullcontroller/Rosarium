---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import SeriesIndex from "../components/SeriesIndex.astro";
import { publicEntry } from "../lib/site";
import PageHeader from "../components/PageHeader.astro";
const all = await getCollection("pages", publicEntry);
---

<Site title="連載" section="articles">
  <PageHeader icon="articles" title="連載" />
  {all
    .filter((e) => e.data.publication_format === "series")
    .map((entry) => (
      <SeriesIndex entry={entry} all={all} />
    ))}
</Site>
