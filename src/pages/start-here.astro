---
import Site from "../layouts/Site.astro";
import { url } from "../lib/site";
const destination = url("about");
const canonical = new URL(destination, Astro.site).toString();
---
<Site title="Rosariumとは？へ移動します" canonical={canonical} noindex showReference={false}>
  <meta slot="head" http-equiv="refresh" content={`0;url=${destination}`} />
  <script is:inline define:vars={{ destination }}>location.replace(destination);</script>
  <h1>Rosariumとは？へ移動します</h1>
  <p>サイトの紹介と読み方は一つのページに統合しました。</p>
  <p><a href={destination}>Rosariumとは？を読む</a></p>
</Site>
