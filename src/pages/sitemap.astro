---
import Site from "../layouts/Site.astro";
import PageHeader from "../components/PageHeader.astro";
import NavIcon from "../components/NavIcon.astro";
import { navigationItemForPath } from "../lib/navigation";
import { domainResponsibilities } from "../data/knowledge-domains.mjs";
import { introductionForPath, url } from "../lib/site";
import { iconForPath } from "../lib/icons";
const domains = ["planning", "dx", "system-design", "ai"].map(path => ({ ...navigationItemForPath(path)!, ...domainResponsibilities[path] }));
const cases = navigationItemForPath("cases")!;
const supporting = [
  { ...navigationItemForPath("")!, detail: "関心の入口と主要な更新を確認し、各専門領域へ進むためのHomeです。" },
  { path:"about", title:"Rosariumとは？", icon:iconForPath("about"), detail:"サイトの目的・制作背景・編集方針と、専門領域やコンテンツの読み方をまとめた紹介ページです。" },
  { ...navigationItemForPath("career")!, detail: "著者の実務経験・現在の専門性と、今後目指すキャリアを確認するページです。" },
  { path: "garden-notes", title: "GARDEN NOTES", icon: iconForPath("updates"), detail: "何を新しく公開し、何を改訂したかを辿る更新履歴です。専門知識の分類や記事検索とは役割を分けています。" },
  { ...navigationItemForPath("retired")!, detail: "旧前提の参考記事と、役割を終えた退役記事を保全する場所です。現在の推奨内容とは区別して読みます。" },
];
const headings = [
  { depth:2, slug:"domain-relationships", text:"専門領域の関係" },
  { depth:2, slug:"choose-domain", text:"関心に応じて読む領域" },
  ...domains.map(item=>({depth:3,slug:`domain-${item.path}`,text:item.title})),
  { depth:2, slug:"cross-domain-cases", text:"事例は専門領域を横断する" },
  { depth:2, slug:"site-gateways", text:"サイトの入口・著者・更新の記録" },
];
---
<Site title="サイトマップ" section="sitemap" summary="Rosariumが扱うIT戦略・企画、DX、システム設計、AI・数理の役割と関係、関心に応じた読み分けを案内します。" headings={headings}>
  <PageHeader title="サイトマップ" summary="Rosariumは、価値と構想、業務・組織の変革、技術による実現、その基礎原理を扱う技術ポートフォリオです。" />
  <div class="architecture-map" data-architecture-guide>
    <section aria-labelledby="domain-relationships">
      <h2 id="domain-relationships">専門領域の関係</h2>
      <figure class="domain-relationships" aria-labelledby="relationship-caption">
        <div class="relationship-purpose"><NavIcon name={domains[0].icon} /><strong>{domains[0].title}</strong><span>目的・価値・実現する範囲を定める</span></div>
        <p class="relationship-connector">↓ 目的と範囲を共有する</p>
        <div class="relationship-pair">
          <div><NavIcon name={domains[1].icon} /><strong>{domains[1].title}</strong><span>業務・組織・価値を変える</span></div>
          <span class="relationship-align">相互に整合</span>
          <div><NavIcon name={domains[2].icon} /><strong>{domains[2].title}</strong><span>要件・方式・品質を具体化する</span></div>
        </div>
        <p class="relationship-feedback">成果と制約を、次の構想・業務・設計へ戻す</p>
        <div class="relationship-foundation"><NavIcon name={domains[3].icon} /><strong>{domains[3].title}</strong><span>AIを使う設計を、数学的・計算的原理から支える</span></div>
        <div class="relationship-cases"><NavIcon name={cases.icon} /><strong>{cases.title}</strong><span>各領域を横断し、具体的な判断と検証から学ぶ</span></div>
        <figcaption id="relationship-caption">四つの専門領域は上下の優劣や一方向の工程ではありません。業務とシステムを照合し、結果を構想へ戻します。AIは実現手段の一つであり、採用を前提としません。</figcaption>
      </figure>
    </section>
    <section aria-labelledby="choose-domain">
      <h2 id="choose-domain">関心に応じて読む領域</h2>
      {domains.map(item=><section class="domain-description" data-domain={item.path} aria-labelledby={`domain-${item.path}`}>
        <h3 id={`domain-${item.path}`}><NavIcon name={item.icon} /><a href={url(item.path)} data-guide-entry>{item.title}</a></h3>
        <p class="domain-question">{item.question}</p>
        <dl><dt>役割</dt><dd>{item.role}</dd><dt>主な対象</dt><dd>{item.topics}</dd><dt>他領域との違い</dt><dd>{item.boundary}</dd></dl>
      </section>)}
    </section>
    <section aria-labelledby="cross-domain-cases">
      <h2 id="cross-domain-cases"><NavIcon name={cases.icon} /><a href={url(cases.path)} data-guide-entry>事例</a>は専門領域を横断する</h2>
      <p>{introductionForPath("cases")}</p>
      <p>実務事例は、実際の担当範囲・判断・確認済みの成果を読むものです。発展ケーススタディは、実務を起点に追加条件を仮定した設計検討であり、実務実績とは区別します。</p>
      <p>知識の原理や責務を学ぶ各専門領域に対し、事例では「具体的な課題にどう判断し、何を確かめたか」を確認できます。</p>
    </section>
    <section aria-labelledby="site-gateways">
      <h2 id="site-gateways">サイトの入口・著者・更新の記録</h2>
      <dl class="site-roles">{supporting.map(item=><div><dt><NavIcon name={item.icon} /><a href={url(item.path)} data-guide-entry>{item.title}</a></dt><dd>{item.detail}</dd></div>)}</dl>
    </section>
  </div>
</Site>
<style>
.architecture-map > section + section {border-top:1px solid var(--line);padding-top:1.25rem;margin-top:1.5rem;}
.architecture-map h2,.architecture-map h3,.site-roles dt {display:flex;align-items:center;flex-wrap:wrap;gap:.45rem;}
.domain-relationships {margin:1rem 0;}
.relationship-purpose,.relationship-pair > div,.relationship-foundation,.relationship-cases {display:flex;align-items:center;flex-wrap:wrap;gap:.35rem .5rem;padding:.65rem .85rem;border-inline-start:3px solid var(--accent);background:var(--aux-surface);}
.domain-relationships strong {color:var(--accent);}
.domain-relationships span:not(.relationship-align):not(.icon) {flex-basis:100%;font-size:.9rem;}
.relationship-purpose {max-width:32rem;margin-inline:auto;}
.relationship-connector,.relationship-feedback {text-align:center;font-size:.85rem;color:var(--muted);margin:.5rem 0;}
.relationship-pair {display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:stretch;gap:.5rem;}
.relationship-align {align-self:center;font-size:.8rem;color:var(--muted);}
.relationship-foundation,.relationship-cases {margin-top:.6rem;}
.domain-relationships figcaption {font-size:.85rem;color:var(--muted);margin-top:.75rem;}
.domain-description {border-top:1px solid var(--line);padding-block:1rem;}
.domain-description h3 {margin-block:0 .5rem;}
.domain-question {color:var(--accent);font-weight:650;margin-block:.5rem;}
.domain-description dl {display:grid;grid-template-columns:6.5rem minmax(0,1fr);gap:.4rem .75rem;margin-bottom:0;}
.domain-description dt {font-weight:650;}
.domain-description dd,.site-roles dd {margin:0;}
.site-roles > div {padding-block:.75rem;border-top:1px solid var(--line);}
.site-roles dt {font-weight:650;margin-bottom:.35rem;}
@media(max-width:600px){.relationship-pair {grid-template-columns:minmax(0,1fr);}.relationship-align {text-align:center;}.domain-description dl {grid-template-columns:minmax(0,1fr);gap:.25rem;}.domain-description dd {margin-bottom:.5rem;}}
</style>
