---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import ContentIndex from "../components/ContentIndex.astro";
import RelatedPublications from "../components/RelatedPublications.astro";
import { publicEntry } from "../lib/site";
import PageHeader from "../components/PageHeader.astro";
import ThemeArticleIndex from "../components/ThemeArticleIndex.astro";
import { readingEntries, readingNavigation } from "../lib/reading";
const all = await getCollection("pages", publicEntry);
const themeGroups = readingNavigation(all, "practices");
const discoverable = readingEntries(all, "practices");
---

<Site title="実践知" section="practices" themeGroups={themeGroups}>
  <PageHeader title="実践知" status="更新終了" />
  <p class="status-note">現時点で内容が一度まとまったため、積極的な追加更新を終了しています。</p>
  <p class="lead">
    設計原則を、AI導入・教育・横展開・開発Workflowへ適用する。
  </p>
  <ThemeArticleIndex groups={themeGroups} />
  <h2>業務・開発プロセスへの組込み</h2>
  <ContentIndex entries={discoverable} showIcons={false} />
  <RelatedPublications
    summary="設計判断の背景や、個別の問題意識を扱った公開記事です。"
    showIcons={false}
    entries={all.filter(
      (e) =>
        e.data.section === "practices" &&
        e.data.source?.original_type === "article",
    )}
  />
</Site>
