---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import ContentIndex from "../../components/ContentIndex.astro";
import PublicationLink from "../../components/PublicationLink.astro";
import {
  sections,
  activeEntry,
  url,
  introductionForPath,
} from "../../lib/site";
import { isPublication } from "../../lib/navigation";
import PageHeader from "../../components/PageHeader.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { iconForSection } from "../../lib/icons";
export function getStaticPaths() {
  return sections
    .filter(([key]) => !["cases", "practices"].includes(key))
    .map(([section, title, summary]) => ({
      params: { section },
      props: { title, summary },
    }));
}
const { title, summary: sectionSummary } = Astro.props;
const summary = introductionForPath(Astro.url.pathname) ?? sectionSummary;
const all = await getCollection("pages", activeEntry);
const entries = all.filter((e) => e.data.section === Astro.params.section);
const essays = Astro.params.section === "essays";
const oldFoundations = Astro.params.section === "foundations";
---

<Site
  title={
    oldFoundations
      ? "設計資料アーカイブ"
      : essays
        ? title
        : `${title} — コンテンツ一覧`
  }
  section={essays ? "articles" : "ai-design"}
  summary={summary}
  noindex={!essays}
>
  <PageHeader
    icon={iconForSection(essays ? "articles" : Astro.params.section)}
    title={oldFoundations ? "設計資料アーカイブ" : title}
    summary={summary}
  />
  {oldFoundations ? (
    <>
      <p>
        主要な入口は<a href={url("start-here")}>Start Here</a>
        から選べます。
      </p>
    </>
  ) : essays ? (
    <p>
      <a href={url("ai")}>AI</a>
      のうち、市場・キャリア・技術への論考を読む入口です。
    </p>
  ) : (
    <p>
      設計知識の入口は
      <a href={url("ai-design/" + Astro.params.section)}>AI設計 / {title}</a>
      です。
    </p>
  )}
  {essays ? (
    <>
    <div class="document-list">
      {entries.filter((entry) => isPublication(entry) && entry.data.lifecycle === "active").map((entry) => (
        <article>
          <PublicationLink entry={entry} heading="h2" />
        </article>
      ))}
    </div>
    </>
  ) : (
    <>
      <SectionHeading icon="ai-design" title="AI設計" />
      <ContentIndex
        entries={entries.filter((e) => e.data.layer === "ai-design")}
      />
      {entries.some((e) => e.data.layer === "ai-mathematics") && (
        <section>
          <SectionHeading icon="ai-mathematics" title="AI理論" />
          <ContentIndex
            entries={entries.filter((e) => e.data.layer === "ai-mathematics")}
          />
        </section>
      )}
      {entries.some((e) => e.data.layer === "practice") && (
        <section>
          <SectionHeading icon="practices" title="実践知" />
          <ContentIndex
            entries={entries.filter((e) => e.data.layer === "practice")}
          />
        </section>
      )}
    </>
  )}
</Site>
