---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import ContentIndex from "../../components/ContentIndex.astro";
import { designTopics } from "../../lib/navigation";
import { activeEntry, url } from "../../lib/site";
import PageHeader from "../../components/PageHeader.astro";
import { aiDesignTopicGuides, orderedDesignEntries } from "../../lib/ai-design";
export function getStaticPaths() {
  return designTopics.map(([topic, title, summary]) => ({
    params: { topic },
    props: { topic, title, summary },
  }));
}
const { topic, title, summary } = Astro.props;
const guide = aiDesignTopicGuides[topic];
const all = await getCollection("pages", activeEntry);
---

<Site
  title={title}
  section="ai-design"
  summary={summary}
  ogImage="og/ai-design.png"
>
  <nav class="breadcrumb">
    <a href={url("ai-design")}>AI設計</a> / {title}
  </nav>
  <PageHeader title={title} summary={summary} />
  <p data-ai-design-guide>{guide.question}</p>
  {topic === "architecture" && (
    <p>
      既存ツールとの役割分担を具体的な経験から考える場合は、
      <a href={url("software-engineering/multi-ai-orchestration")}>複数AIの役割分担と工程設計</a>
      も読めます。
    </p>
  )}
  <ContentIndex
    showIcons={false}
    entries={orderedDesignEntries(all, topic)}
  />
  <p data-ai-design-next>
    {guide.next.reason}
    <a href={url(guide.next.path)}>{guide.next.title}</a>
  </p>
</Site>
