---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import ContentIndex from "../../components/ContentIndex.astro";
import { aiDesignAreas, aiDesignTopicOrder, orderedDesignEntries } from "../../lib/ai-design";
import { designTopics } from "../../lib/navigation";
import { activeEntry, url } from "../../lib/site";
import PageHeader from "../../components/PageHeader.astro";
const all = await getCollection("pages", activeEntry);
const topics = aiDesignTopicOrder.map((topic) => designTopics.find(([key]) => key === topic)!);
const designFlow = ["価値・適用判断", "責任・情報・評価", "構成・実行・権限", "運用・改善", "再評価・縮小・終了"];
---

<Site
  title="AI設計"
  section="ai-design"
  ogImage="og/ai-design.png"
>
  <PageHeader title="AI設計" />
  <p>
    AI技術の導入を目的にせず、実現したい業務変化からAI・人間・既存システムの役割を決めます。AIを使わない判断も、AI設計の一部です。
  </p>

  <p>目的・業務目標・システム化の範囲を決める<a href={url("planning")}>企画</a>と、その要求を要件・方式へ具体化する設計を区別します。技術検証の結果から企画へ戻る場合も、判断の対象を分けます。</p>

  <section aria-labelledby="value-first-design">
    <h2 id="value-first-design">価値から始める</h2>
    <ol class="design-flow" aria-label="価値から再設計までの設計順序">
      {designFlow.map((stage) => (
        <li>{stage}</li>
      ))}
    </ol>
    <p>
      <a href={url("foundations/applicability-and-delegation")}>
        価値からAIの適用可否と委任範囲を考える
      </a>
    </p>
  </section>

  <section aria-labelledby="applied-ai-areas">
    <h2 id="applied-ai-areas">AIを業務・システムへ組み込むための設計領域</h2>
    <p>
      番号は読む順の目安です。実装の固定順ではなく、評価や運用で分かったことを前の判断へ戻しながら設計します。各項目から設計の説明、または領域別の記事へ進めます。
    </p>
    <ol class="design-area-list">
      {aiDesignAreas.map((area, index) => (
        <li id={area.id}>
          <p class="eyebrow">{String(index + 1).padStart(2, "0")} · {area.scope}</p>
          <h3>
            <a href={url(area.path)}>{area.title}</a>
          </h3>
          <p>{area.summary}</p>
        </li>
      ))}
    </ol>
  </section>

  <h2 id="design-articles">設計領域ごとの記事</h2>
  <p>上の設計領域から読む内容を選んだ後、関連する原則や詳しい手順を領域ごとに確認できます。</p>
  {topics.map(([key, title, summary]) => (
    <section>
      <h2><a href={url("ai-design/" + key)}>{title}</a></h2>
      <p>{summary}</p>
      <ContentIndex
        showIcons={false}
        entries={orderedDesignEntries(all, key)}
      />
    </section>
  ))}
</Site>
