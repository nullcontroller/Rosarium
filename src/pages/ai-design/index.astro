---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import ContentIndex from "../../components/ContentIndex.astro";
import { designTopics } from "../../lib/navigation";
import { publicEntry, url } from "../../lib/site";
import PageHeader from "../../components/PageHeader.astro";
import ThemeArticleIndex from "../../components/ThemeArticleIndex.astro";
import { readingNavigation } from "../../lib/reading";
const all = await getCollection("pages", publicEntry);
const themeGroups = readingNavigation(all, "ai-design");
const designFlow = [
  "価値",
  "実現したい業務変化",
  "業務・システム設計",
  "AI・人間・既存システムの役割分担",
  "必要なAI技術",
  "安全性・責任境界",
  "評価・改善",
  "運用・再設計",
];
const appliedAreas = [
  {
    number: "700",
    title: "AI評価設計",
    summary:
      "業務価値、品質、リスク、Human in the Loopを測り、採用と改善へつなぐ。",
    path: "ai-design/evaluation-hitl",
  },
  {
    number: "800",
    title: "AIアーキテクチャ",
    summary: "AI・人間・既存システムを一つの業務システムとして構成する。",
    path: "ai-design/architecture",
  },
  {
    number: "900",
    title: "AI運用",
    summary: "監視、変更、再評価、縮退、停止を継続運用として設計する。",
    path: "ai-design/lifecycle-operations",
  },
  {
    number: "1000",
    title: "AIエージェント設計",
    summary:
      "AIへ渡す情報、使える道具、実行権限を決め、仕事の流れへつなぐ。Tool / Workflow / Contextを分けて設計する。",
    path: "architecture/agents-tools-and-workflows",
  },
  {
    number: "1100",
    title: "AIセキュリティ・権限制御",
    summary: "生成・受理・実行を分離し、必要最小限の権限と停止条件を定める。",
    path: "ai-design/responsibility-control",
  },
  {
    number: "1200",
    title: "AI・既存システム統合",
    summary: "既存仕様と確定的処理を活かし、AIの確率的処理を安全に組み込む。",
    path: "ai-design/software-engineering",
  },
];
---

<Site
  title="AI設計"
  section="ai-design"
  ogImage="og/ai-design.png"
  themeGroups={themeGroups}
>
  <PageHeader title="AI設計" />
  <p>
    AI技術の導入を目的にせず、実現したい業務変化からAI・人間・既存システムの役割を決めます。AIを使わない判断も、AI設計の一部です。
  </p>

  <section aria-labelledby="value-first-design">
    <h2 id="value-first-design">価値から始める</h2>
    <ol class="design-flow" aria-label="価値から再設計までの設計順序">
      {designFlow.map((stage) => (
        <li>{stage}</li>
      ))}
    </ol>
    <p>
      <a href={url("foundations/applicability-and-delegation")}>
        価値からAIの適用可否と委任範囲を考える
      </a>
    </p>
  </section>

  <section aria-labelledby="applied-ai-areas">
    <h2 id="applied-ai-areas">Applied AI設計の接続領域</h2>
    <p>
      既存の設計知識を、設計・構築・評価・運用・改善の循環として接続します。
    </p>
    <ol class="design-area-list">
      {appliedAreas.map((area) => (
        <li>
          <p class="eyebrow">{area.number}</p>
          <h3>
            <a href={url(area.path)}>{area.title}</a>
          </h3>
          <p>{area.summary}</p>
        </li>
      ))}
    </ol>
  </section>

  <ThemeArticleIndex groups={themeGroups} />
  <nav class="topic-navigation" aria-label="AI設計のテーマ">
    {designTopics.map(([key, title]) => (
      <a href={url("ai-design/" + key)}>{title}</a>
    ))}
  </nav>
  {designTopics.map(([key, title, summary]) => (
    <section>
      <h2>{title}</h2>
      <p class="section-title-link">
        <a href={url("ai-design/" + key)}>このテーマを見る</a>
      </p>
      <p>{summary}</p>
      <ContentIndex
        showIcons={false}
        entries={all.filter(
          (e) => e.data.layer === "ai-design" && e.data.design_topic === key,
        )}
      />
    </section>
  ))}
</Site>
