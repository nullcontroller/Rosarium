---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import PageHeader from "../components/PageHeader.astro";
import ContentLink from "../components/ContentLink.astro";
import { activeEntry } from "../lib/site";
import { systemDesignGroups, primaryDomain } from "../data/knowledge-domains.mjs";
const entries = await getCollection("pages", activeEntry);
const groups = systemDesignGroups.map(group => ({ ...group, entries: group.ids.map(id => entries.find(entry => entry.id === id)).filter(entry => !!entry && primaryDomain(entry) === "system-design") })).filter(group => group.entries.length > 0);
const headings = groups.map(group => ({depth:2,slug:group.id,text:group.title}));
---
<Site title="システム設計" section="system-design" headings={headings}>
  <PageHeader alignHero navigationPath="system-design" title="システム設計" eyebrow="SYSTEM DESIGN" />
  <p>要求を機能・品質・構成・処理・データ・運用へ具体化します。AIの採用を前提とせず、実現方式と品質を設計します。</p>
  {groups.map(group => <section aria-labelledby={group.id}>
    <h2 id={group.id}>{group.title}</h2>
    <p>{group.summary}</p>
    <div class="document-list">{group.entries.map(entry => <ContentLink entry={entry!} heading="h3" />)}</div>
  </section>)}
  <span id="case-design" aria-hidden="true"></span>
</Site>
