---
import Site from "../../layouts/Site.astro";
import { url } from "../../lib/site";

const successor = url("software-engineering/code-generation-and-work-design");
const canonical = new URL(successor, Astro.site).toString();
---

<Site
  title="設計支援AIの記事を統合しました"
  summary="設計支援AIの記事は、現在の設計思想を反映した後継記事へ統合しました。"
  canonical={canonical}
  noindex
  showLastUpdated={false}
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${successor}`} />
  <script is:inline define:vars={{ successor }}>
    location.replace(successor);
  </script>
  <h1>設計支援AIの記事を統合しました</h1>
  <p>
    コード生成と設計判断の関係は、後継記事で現在の考え方に基づいて整理しています。
  </p>
  <p>
    <a href={successor}>「コード生成AIはなぜ業務を変えないのか」へ移動する</a>
  </p>
</Site>
