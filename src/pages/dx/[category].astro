---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import PageHeader from "../../components/PageHeader.astro";
import ContentIndex from "../../components/ContentIndex.astro";
import {
  dxCategories,
  dxEntriesForCategory,
  dxIntroductionParagraphs,
  type DxCategoryId,
} from "../../lib/dx";
import { activeEntry, url } from "../../lib/site";

export function getStaticPaths() {
  return dxCategories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const all = await getCollection("pages", activeEntry);
const entries = dxEntriesForCategory(all, category.id as DxCategoryId);
const articles = entries.filter((entry) => entry.data.section !== "cases");
---

<Site
  title={`${category.title} — DX`}
  analyticsTitle={category.title}
  section={`dx/${category.id}`}
  summary={category.summary}
  breadcrumbs={[
    { name: "庭", path: "" },
    { name: "DX", path: "dx" },
    { name: category.title, path: `dx/${category.id}` },
  ]}
>
  <nav class="breadcrumb" aria-label="現在位置">
    <a href={url()}>庭</a> / <a href={url("dx")}>DX</a>
  </nav>
  <PageHeader
    title={category.title}
    eyebrow="DX THEME"
    summary={category.summary}
    summaryParagraphs={dxIntroductionParagraphs(category.summary)}
  />
  <p>{category.scope}</p>

  {articles.length > 0 && (
    <section aria-labelledby="dx-theme-articles">
      <h2 id="dx-theme-articles">記事・設計知識</h2>
      <ContentIndex entries={articles} showIcons={false} />
    </section>
  )}


</Site>
