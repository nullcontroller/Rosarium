---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import SeriesIndex from "../components/SeriesIndex.astro";
import { caseStudies } from "../lib/navigation";
import { activeEntry, url } from "../lib/site";
import PageHeader from "../components/PageHeader.astro";
const all = await getCollection("pages", activeEntry);
---

<Site title="Books — 実務事例" section="cases">
  <PageHeader icon="cases" title="Books — 実務事例" />
  {caseStudies.filter((study) => all.some((entry) => entry.id === study.book)).map((study) => (
    <SeriesIndex entry={all.find((e) => e.id === study.book)!} all={all} />
  ))}
  <p>
    <a href={url("series")}>設計原則の連載</a>
  </p>
</Site>
