---
import NavIcon from "../components/NavIcon.astro";
import Site from "../layouts/Site.astro";
import GrowthEntry from "../components/GrowthEntry.astro";
import { recentGrowth } from "../data/recent-growth";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { url } from "../lib/site";

const recent = recentGrowth.slice(0, 3);
---

<Site toc="never" rightSidebarInitiallyClosed title="Home" section="">
  <div class="home-hero-layout">
    <PageHeader
      alignHero
      navigationPath=""
      title="Rosarium"
      summaryParagraphs={[
        "Rosariumは、IT戦略・企画、DX、システム設計、AI・数理の専門知識と事例を整理・公開する技術ポートフォリオです。",
        "価値と構想、業務と組織の変革、技術による実現と基礎原理を、具体的な問題解決・設計判断につなげます。",
      ]}
    >
      <nav class="home-primary-links" aria-label="主要な閲覧先">
        <a class="home-navigation-card" href={url("career")}>
          <NavIcon name="career" /><span><strong>作者のキャリア</strong><small>専門性・実務経験・今後の方向性</small></span><span aria-hidden="true">→</span>
        </a>
        <a class="home-navigation-card" href={url("cases")}>
          <NavIcon name="cases" /><span><strong>事例を見る</strong><small>実務事例・発展ケーススタディ</small></span><span aria-hidden="true">→</span>
        </a>
        <a class="home-navigation-card" href={url("about")}>
          <NavIcon name="about" /><span><strong>Rosariumとは？</strong><small>目的・専門領域・コンテンツの読み方</small></span><span aria-hidden="true">→</span>
        </a>
      </nav>
    </PageHeader>
    <aside class="home-main-case" aria-labelledby="home-main-case-heading">
      <p class="eyebrow">MAIN CASE / 代表設計事例</p>
      <h2 id="home-main-case-heading">問い合わせDXの要件・方式設計</h2>
      <p>実際の業務課題をもとにRAG管理システムを設計・構築し、製品・版数・利用環境による検索対象制御を導入。PoCの回答正答率を72％から96％へ改善し、設定した目標を達成した実務事例です。</p>
      <p class="meta">本番運用での業務効果は測定していません。</p>
      <a class="cta-link" href={url("cases/customer-support-ai-dx")}>問い合わせDXの設計事例を見る <span aria-hidden="true">→</span></a>
    </aside>
  </div>

  <section class="home-section home-panel home-garden-notes" aria-labelledby="recent-growth-heading">
    <SectionHeading icon="updates" eyebrow="GARDEN NOTES" title="最近の手入れ" id="recent-growth-heading" />
    <div class="home-growth-toolbar">
      <p class="meta">最近の公開・改訂・統合の記録です。</p>
      <a class="cta-link" href={url("garden-notes")}>Garden Notesの全履歴を見る</a>
    </div>
    <div class="growth-list growth-list-compact home-growth-history">
      {recent.map((entry) => <GrowthEntry entry={entry} compact />)}
    </div>
  </section>

</Site>

<style>
  .home-primary-links { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; margin-top:.5rem; }
  .home-navigation-card { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:.65rem; padding:1rem; border:1px solid var(--line); border-radius:var(--home-panel-radius,.35rem); background:var(--home-panel-surface,var(--surface)); color:var(--ink); text-decoration:none; }
  .home-navigation-card strong { display:block; font-size:1.125rem; line-height:1.5; color:var(--accent); }
  .home-navigation-card small { display:block; margin-top:.25rem; font-size:.875rem; line-height:1.6; color:var(--muted); }
  .home-navigation-card:hover { border-color:var(--accent); background:var(--aux-surface); }
  .home-navigation-card:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }

  @media (max-width:1280px) { .home-primary-links { grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr)); } }
  @media (max-width:600px) { .home-primary-links { grid-template-columns:1fr; gap:.5rem; } }
  .home-hero-layout { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; margin-bottom: 1.3rem; }
  .home-hero-layout :global(.page-heading) { min-width: 0; margin-bottom: 0; }
  .home-main-case { display: flex; flex-direction: column; justify-content: flex-start; min-width: 0; padding: 1.25rem 1.375rem; border: 1px solid var(--accent); border-radius: var(--home-panel-radius, .35rem); background: color-mix(in srgb, var(--home-panel-surface, var(--surface)) 94%, var(--accent)); }
  .home-main-case h2 { margin: .5rem 0 0; font-size: 1.25rem; line-height: 1.5; }
  .home-main-case .eyebrow { margin: 0; font-size: .875rem; letter-spacing: .08em; }
  .home-main-case p { margin-block: .5rem .25rem; color: var(--muted); font-size: .95rem; line-height: 1.65; }
  .home-main-case a { display: inline-flex; align-items: center; align-self: flex-start; gap: .5rem; min-height: 44px; color: var(--accent); font-size: .95rem; font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .25em; }
  .home-main-case:hover, .home-main-case:focus-within { border-color: var(--accent); }
  .home-main-case a:hover { color: var(--ink); }
  @media (max-width:1100px) { .home-hero-layout { grid-template-columns:1fr; } }
  @media (max-width: 800px) {
    .home-hero-layout { grid-template-columns:1fr; gap:1rem; }
    .home-main-case { padding: 1.25rem 1rem; }
  }

  .home-garden-notes { width: 100%; max-width: none; box-sizing: border-box; }
  .home-growth-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .35rem 1.25rem; }
  .home-growth-toolbar > p { margin-block: .3rem; }
  .home-growth-toolbar > a { color: var(--accent); font-weight: 600; text-underline-offset: .2em; }
  .home-growth-history {
    padding: .5rem .75rem;
    border: 1px solid var(--line);
    overflow-wrap: anywhere;
    background: var(--home-panel-surface, var(--surface));
  }

</style>
