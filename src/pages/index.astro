---
import { navigation } from "../lib/navigation";
import Site from "../layouts/Site.astro";
import GrowthEntry from "../components/GrowthEntry.astro";
import { recentGrowth } from "../data/recent-growth";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { url } from "../lib/site";

const homeIcon = navigation.flat().find((item) => item.path === "")!.icon;
const recent = recentGrowth.slice(0, 1);
---

<Site showRightSidebar={false} title="Home" section="">
  <section class="hero home-introduction">
    <div class="document-title-row">
      <Icon name={homeIcon} size="page" />
      <h1>Rosarium</h1>
    </div>
    <p class="home-site-description">
      AIを主軸に、DX・システム設計を考える個人の技術サイトです。学習と実務で得た実践例・設計判断を整理しています。
    </p>
    <p class="meta">
      <a class="action-link" href={url("about")}>
        Rosariumとは？
      </a>
    </p>
  </section>

  <div class="home-primary-panels">
    <section class="home-section" aria-labelledby="recent-growth-heading">
      <SectionHeading
        icon="updates"
        eyebrow="GARDEN NOTES"
        title="最近の手入れ"
        id="recent-growth-heading"
      />
      <p class="meta">
        記事や事例の公開・改訂・統合・整理など、主な手入れを記録しています。
      </p>
      <div class="growth-list growth-list-compact">
        {recent.map((entry) => (
          <GrowthEntry entry={entry} maxChanges={4} />
        ))}
      </div>
      <p><a class="cta-link" href={url("garden-notes")}>Garden Notes</a></p>
    </section>

    <section
      class="home-section home-career"
      aria-labelledby="home-career-heading"
    >
      <SectionHeading
        icon="career"
        eyebrow="PROFILE / CAREER"
        title="キャリア"
        id="home-career-heading"
      />
      <p class="career-overview">立林 裕太朗は、業務課題を整理し、AI・人間・既存システムの役割を決め、運用できる仕組みを設計しています。</p>
      <p class="career-background">仕事の考え方と、その背景を紹介します。</p>
      <p>
        <a class="cta-link" href={url("career")}>
          キャリア
        </a>
      </p>
    </section>
  </div>
</Site>
