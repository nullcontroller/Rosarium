---
import Site from "../layouts/Site.astro";
import Case from "../components/Case.astro";
import { caseStudies } from "../lib/navigation";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { url } from "../lib/site";

const featuredCases = ["cases/specification-debt-review", "cases/three-ai-maintenance", "cases/customer-support-ai-dx"].map(id => caseStudies.find(study => study.book === id)!);
const caseTitles: Record<string, string> = { "cases/specification-debt-review": "仕様書横断レビュー", "cases/three-ai-maintenance": "複数AIを使い分けたレガシー保守", "cases/customer-support-ai-dx": "顧客サポートQAの要件・方式設計" };
const caseSummaries: Record<string, string> = {
  "cases/specification-debt-review": "仕様書とコードを横断レビューし、約40件の問題を確認。根拠をもとに修正と現状維持を判断しました。",
  "cases/three-ai-maintenance": "暗号処理・異常系の保守を複数AIと人間の確認で内製し、外部委託を不要にしました。",
  "cases/customer-support-ai-dx": "与えられた業務目標を、追加質問・検索対象制御・RAG・有人引継ぎの要件と方式へ具体化しました。",
};
---

<Site toc="never" rightSidebarInitiallyClosed title="Home" section="">
  <div class="home-hero-layout">
    <PageHeader
      alignHero
      navigationPath=""
      title="Rosarium"
      summaryParagraphs={[
        "Rosariumは、立林裕太朗個人の技術サイトです。",
        "2016年からのC# / .NETによるWindowsソフトウェア開発・保守を基盤に、要件定義・システム設計、Applied AIに取り組んでいます。\n既存システムの理解・改善と、AIを業務へ組み込む設計の知識と実践事例を整理しています。",
      ]}
    >
      <p class="meta">
        <a class="action-link" href={url("about")}>Rosariumとは？</a>
      </p>
    </PageHeader>
    <aside class="home-career" aria-labelledby="home-career-heading">
      <h2 class="eyebrow" id="home-career-heading">PROFILE / CAREER</h2>
      <p class="career-overview"><span>AI・人間・既存システムの役割を整理し、</span><span>業務要求から要件・設計・運用までをつなぐ仕組みを考えています。</span><span>仕事の考え方と専門性を紹介します。</span></p>
      <a class="cta-link" href={url("career")}>キャリアを見る <span aria-hidden="true">→</span></a>
    </aside>
  </div>

  <section class="home-section home-panel" aria-labelledby="featured-cases-heading">
    <SectionHeading icon="cases" eyebrow="CASE STUDIES" title="代表実績・設計事例" id="featured-cases-heading" />
    <p class="meta">担当範囲、設計判断、成果と限界を、実践事例から確認できます。</p>
    {featuredCases.map(study => <Case title={caseTitles[study.book]}>
      <p class="meta">{study.referenceNote}</p>
      <p>{caseSummaries[study.book]}</p>
      <a href={url(study.book)}>事例の詳細を見る</a>
    </Case>)}
  </section>

</Site>

<style>
  .career-overview > span { display: block; }
  .home-hero-layout { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 3fr); gap: 1.5rem; align-items: stretch; margin-bottom: 1.3rem; }
  .home-hero-layout :global(.page-heading) { min-width: 0; margin-bottom: 0; }
  .home-hero-layout :global(.lead) { white-space: pre-line; }
  .home-career { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: 1.125rem 1.375rem; border: 1px solid var(--accent); border-radius: var(--home-panel-radius, .35rem); background: color-mix(in srgb, var(--home-panel-surface, var(--surface)) 94%, var(--accent)); }
  .home-career h2 { margin: 0; font-size: .875rem; letter-spacing: .12em; }
  .home-career p { margin-block: .75rem .5rem; color: var(--muted); font-size: .95rem; line-height: 1.65; }
  .home-career a { display: inline-flex; align-items: center; align-self: flex-start; gap: .5rem; min-height: 44px; color: var(--accent); font-size: .95rem; font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .25em; }
  .home-career:hover, .home-career:focus-within { border-color: var(--accent); }
  .home-career a:hover { color: var(--ink); }
  @media (min-width: 1100px) {
    .home-hero-layout { grid-template-columns: minmax(0, 1fr) 34rem; max-width: 84rem; margin-inline: auto; }
    .home-career { justify-self: end; width: 100%; }
    .career-overview > span { white-space: nowrap; }
  }
  @media (max-width: 800px) {
    .home-hero-layout { grid-template-columns: minmax(0, 1fr); gap: .75rem; }
    .home-career { padding: 1rem; }
  }

</style>
