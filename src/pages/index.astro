---
import Site from "../layouts/Site.astro";
import GrowthEntry from "../components/GrowthEntry.astro";
import { inRecentWindow } from "../lib/history-window";
import { recentGrowth } from "../data/recent-growth";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { url } from "../lib/site";

const recent = recentGrowth.filter(entry => inRecentWindow(entry.date));
---

<Site showRightSidebar={false} title="Home" section="">
  <div class="home-hero-layout">
    <PageHeader
      alignHero
      navigationPath=""
      title="Rosarium"
      summaryParagraphs={[
        "Rosariumは、立林裕太朗個人の技術サイトです。",
        "AIを主軸に、DX・システム設計を考え、学習と実務で得た実践例・設計判断を整理しています。",
      ]}
    >
      <p class="meta">
        <a class="action-link" href={url("about")}>Rosariumとは？</a>
      </p>
    </PageHeader>
    <aside class="home-career" aria-labelledby="home-career-heading">
      <h2 class="eyebrow" id="home-career-heading">PROFILE / CAREER</h2>
      <p class="career-overview">AI・人間・既存システムの役割を整理し、業務要求から要件・設計・運用までをつなぐ仕組みを考えています。仕事の考え方と専門性を紹介します。</p>
      <a class="cta-link" href={url("career")}>キャリアを見る <span aria-hidden="true">→</span></a>
    </aside>
  </div>

  <div class="home-primary-panels">
    <section class="home-section home-panel" aria-labelledby="recent-growth-heading">
      <SectionHeading
        icon="updates"
        eyebrow="GARDEN NOTES"
        title="最近の手入れ"
        id="recent-growth-heading"
      />
      <p class="meta">
        直近30日間の記事・事例の公開や改訂を、件数中心に記録しています。
      </p>
      <p class="meta" data-growth-empty hidden={recent.length > 0}>直近30日間の更新はありません。</p>
      <div class="growth-list growth-list-compact home-growth-history" data-recent-growth role="region" tabindex="0" aria-label="Garden Notes 更新履歴">
        {recent.map((entry) => (
          <GrowthEntry entry={entry} />
        ))}
      </div>
      <p><a class="cta-link" href={url("garden-notes")}>Garden Notes</a></p>
    </section>
  </div>
</Site>

<script>
  import { inRecentWindow } from "../lib/history-window";
  function refreshRecentGrowth() {
    const list = document.querySelector("[data-recent-growth]");
    if (!list) return;
    const entries = Array.from(list.querySelectorAll<HTMLElement>("[data-growth-date]"));
    for (const entry of entries) entry.hidden = !inRecentWindow(entry.dataset.growthDate ?? "");
    const empty = document.querySelector<HTMLElement>("[data-growth-empty]");
    if (empty) empty.hidden = entries.some(entry => !entry.hidden);
  }
  refreshRecentGrowth();
  document.addEventListener("astro:page-load", refreshRecentGrowth);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) refreshRecentGrowth(); });
</script>

<style>
  .home-hero-layout { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 3fr); gap: 1.5rem; align-items: stretch; margin-bottom: 1.3rem; }
  .home-hero-layout :global(.page-heading) { min-width: 0; margin-bottom: 0; }
  .home-career { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: 1.125rem 1.375rem; border: 1px solid var(--aux-border); border-radius: var(--home-panel-radius, .35rem); background: color-mix(in srgb, var(--home-panel-surface, var(--surface)) 94%, var(--accent)); }
  .home-career h2 { margin: 0; font-size: .875rem; letter-spacing: .12em; }
  .home-career p { margin-block: .75rem .5rem; color: var(--muted); font-size: .95rem; line-height: 1.65; }
  .home-career a { display: inline-flex; align-items: center; align-self: flex-start; gap: .5rem; min-height: 44px; color: var(--accent); font-size: .95rem; font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .25em; }
  .home-career:hover, .home-career:focus-within { border-color: var(--accent); }
  .home-career a:hover { color: var(--ink); }
  @media (max-width: 800px) {
    .home-hero-layout { grid-template-columns: minmax(0, 1fr); gap: .75rem; }
    .home-career { padding: 1rem; }
  }

  .home-growth-history {
    max-height: min(40rem, 60vh);
    overflow-y: auto;
    overflow-x: hidden;
    padding: .5rem .75rem;
    border: 1px solid var(--line);
    overflow-wrap: anywhere;
    background:
      linear-gradient(to top, var(--home-panel-surface, var(--surface)) 30%, transparent) center bottom / 100% 2rem local no-repeat,
      linear-gradient(to top, var(--scroll-fade), transparent) center bottom / 100% 1.5rem scroll no-repeat,
      var(--home-panel-surface, var(--surface));
  }
  .home-growth-history:not(:has(:global([data-growth-entry]:not([hidden])))) { display: none; }
  @media (pointer: fine) {
    .home-growth-history { scrollbar-width: thin; scrollbar-color: var(--muted) var(--home-panel-surface, var(--surface)); scrollbar-gutter: stable; }
  }
  @media (min-width: 801px) and (max-width: 1100px) {
    .home-growth-history { max-height: 50vh; }
  }
  @media (max-width: 800px) {
    .home-growth-history { max-height: 45vh; max-height: 45svh; }
  }
  [data-recent-growth] :global([data-growth-entry][hidden]),
  [data-growth-empty][hidden] { display: none; }
</style>
