---
import { navigationItemForPath } from "../lib/navigation";
import Site from "../layouts/Site.astro";
import GrowthEntry from "../components/GrowthEntry.astro";
import { inRecentWindow } from "../lib/history-window";
import { recentGrowth } from "../data/recent-growth";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { url } from "../lib/site";

const homeIcon = navigationItemForPath("")!.icon;
const recent = recentGrowth.filter(entry => inRecentWindow(entry.date));
---

<Site showRightSidebar={false} title="Home" section="">
  <section class="hero home-introduction">
    <div class="document-title-row">
      <Icon name={homeIcon} size="page" />
      <h1>Rosarium</h1>
    </div>
    <p class="home-site-description">
      AIを主軸に、DX・システム設計を考える個人の技術サイトです。学習と実務で得た実践例・設計判断を整理しています。
    </p>
    <p class="meta">
      <a class="action-link" href={url("about")}>
        Rosariumとは？
      </a>
    </p>
  </section>

  <div class="home-primary-panels">
    <section class="home-section" aria-labelledby="recent-growth-heading">
      <SectionHeading
        icon="updates"
        eyebrow="GARDEN NOTES"
        title="最近の手入れ"
        id="recent-growth-heading"
      />
      <p class="meta">
        直近30日間の記事・事例の公開や改訂を、件数中心に記録しています。
      </p>
      <p class="meta" data-growth-empty hidden={recent.length > 0}>直近30日間の更新はありません。</p>
      <div class="growth-list growth-list-compact" data-recent-growth>
        {recent.map((entry) => (
          <GrowthEntry entry={entry} />
        ))}
      </div>
      <p><a class="cta-link" href={url("garden-notes")}>Garden Notes</a></p>
    </section>

    <section
      class="home-section home-career"
      aria-labelledby="home-career-heading"
    >
      <SectionHeading
        icon="career"
        eyebrow="PROFILE / CAREER"
        title="キャリア"
        id="home-career-heading"
      />
      <p class="career-overview">立林 裕太朗は、業務課題を整理し、AI・人間・既存システムの役割を決め、運用できる仕組みを設計しています。</p>
      <p class="career-background">仕事の考え方と、その背景を紹介します。</p>
      <p>
        <a class="cta-link" href={url("career")}>
          キャリア
        </a>
      </p>
    </section>
  </div>
</Site>

<script>
  import { inRecentWindow } from "../lib/history-window";
  function refreshRecentGrowth() {
    const list = document.querySelector("[data-recent-growth]");
    if (!list) return;
    const entries = Array.from(list.querySelectorAll<HTMLElement>("[data-growth-date]"));
    for (const entry of entries) entry.hidden = !inRecentWindow(entry.dataset.growthDate ?? "");
    const empty = document.querySelector<HTMLElement>("[data-growth-empty]");
    if (empty) empty.hidden = entries.some(entry => !entry.hidden);
  }
  refreshRecentGrowth();
  document.addEventListener("astro:page-load", refreshRecentGrowth);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) refreshRecentGrowth(); });
</script>

<style>
  [data-recent-growth] :global([data-growth-entry][hidden]),
  [data-growth-empty][hidden] { display: none; }
</style>
