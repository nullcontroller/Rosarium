---
import Site from "../layouts/Site.astro";
import GrowthEntry from "../components/GrowthEntry.astro";
import { recentGrowth } from "../data/recent-growth";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { url } from "../lib/site";
import { featuredCaseHighlights } from "../lib/navigation";

const recent = recentGrowth.slice(0, 3);
---

<Site toc="never" rightSidebarInitiallyClosed title="Home" section="">
  <div class="home-hero-layout">
    <PageHeader
      alignHero
      navigationPath=""
      title="Rosarium"
      summaryParagraphs={[
        "問い合わせDXを、業務要求からシステム方式へ。",
        "顧客の自己解決と専門サポートを両立するため、生成AI・RAG・検索対象制御・有人引継ぎを組み合わせたシステム方式を設計。要件定義から評価条件まで具体化した設計・検証シナリオを紹介します。",
      ]}
    >
      <p class="meta home-career-link"><span>2016年からC# / .NETによるソフトウェア開発・保守を経験。</span><a class="action-link" href={url("career")}>キャリアを見る</a></p>
      <p class="meta">
        <a class="action-link" href={url("about")}>Rosariumとは？</a>
        <span aria-hidden="true"> · </span>
        <a class="action-link" href={url("cases")}>実践事例を見る</a>
      </p>
    </PageHeader>
    <aside class="home-main-case" aria-labelledby="home-main-case-heading">
      <p class="eyebrow">MAIN CASE / 代表設計事例</p>
      <h2 id="home-main-case-heading">問い合わせDXの要件・方式設計</h2>
      <p>業務要求をシステム要件へ具体化。生成AI・RAG・検索対象制御・回答許可判定・有人引継ぎ・評価条件を設計しました。</p>
      <p class="meta">設計・検証シナリオであり、本番導入済みの実績ではありません。</p>
      <a class="cta-link" href={url("cases/customer-support-ai-dx")}>問い合わせDXの設計事例を見る <span aria-hidden="true">→</span></a>
    </aside>
  </div>

  <section class="home-section home-panel" aria-labelledby="home-cases-heading">
    <SectionHeading icon="cases" title="代表実績・設計事例" id="home-cases-heading" />
    <section aria-labelledby="featured-case-heading">
      <p class="eyebrow">{featuredCaseHighlights[0].category}</p>
      <h3 id="featured-case-heading"><a href={url(featuredCaseHighlights[0].id)}>{featuredCaseHighlights[0].title}</a></h3>
      <p>業務要件、検索と回答許可の責任境界、PoCでの方式改善をBookで説明します。</p>
    </section>
    <h3>設計を支える実務実績</h3>
    <ul>
      {featuredCaseHighlights.slice(1).map((item) => <li>
        <a href={url(item.id)}>{item.title}</a> <span class="meta">{item.category}</span>
        <p>{item.summary}</p>
      </li>)}
    </ul>
    <p class="meta"><a href={url("software-engineering/engineering-judgment-in-ai-code-review")}>AIで調査候補を絞り、終了処理の順序から問題箇所を特定した経験</a></p>
  </section>
  <section class="home-section home-panel home-garden-notes" aria-labelledby="recent-growth-heading">
    <SectionHeading icon="updates" eyebrow="GARDEN NOTES" title="最近の手入れ" id="recent-growth-heading" />
    <div class="home-growth-toolbar">
      <p class="meta">最近の公開・改訂・統合の記録です。</p>
      <a class="cta-link" href={url("garden-notes")}>Garden Notesの全履歴を見る</a>
    </div>
    <div class="growth-list growth-list-compact home-growth-history" role="region" tabindex="0" aria-label="Garden Notes 最近の更新">
      {recent.map((entry) => <GrowthEntry entry={entry} />)}
    </div>
  </section>

</Site>

<style>
  .home-career-link { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .75rem; }
  .home-hero-layout { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 3fr); gap: 1.5rem; align-items: stretch; margin-bottom: 1.3rem; }
  .home-hero-layout :global(.page-heading) { min-width: 0; margin-bottom: 0; }
  .home-hero-layout :global(.lead) { white-space: pre-line; }
  .home-main-case { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: 1.125rem 1.375rem; border: 1px solid var(--accent); border-radius: var(--home-panel-radius, .35rem); background: color-mix(in srgb, var(--home-panel-surface, var(--surface)) 94%, var(--accent)); }
  .home-main-case h2 { margin: .75rem 0 0; font-size: 1.25rem; line-height: 1.5; }
  .home-main-case .eyebrow { margin: 0; font-size: .875rem; letter-spacing: .08em; }
  .home-main-case p { margin-block: .75rem .5rem; color: var(--muted); font-size: .95rem; line-height: 1.65; }
  .home-main-case a { display: inline-flex; align-items: center; align-self: flex-start; gap: .5rem; min-height: 44px; color: var(--accent); font-size: .95rem; font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .25em; }
  .home-main-case:hover, .home-main-case:focus-within { border-color: var(--accent); }
  .home-main-case a:hover { color: var(--ink); }
  @media (min-width: 1100px) {
    .home-hero-layout { grid-template-columns: minmax(0, 1fr) 34rem; max-width: 84rem; margin-inline: auto; }
    .home-main-case { justify-self: end; width: 100%; }

  }
  @media (max-width: 800px) {
    .home-hero-layout { grid-template-columns: minmax(0, 1fr); gap: .75rem; }
    .home-main-case { padding: 1rem; }
  }

  .home-garden-notes { width: 100%; max-width: none; box-sizing: border-box; }
  .home-growth-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .35rem 1.25rem; }
  .home-growth-toolbar > p { margin-block: .3rem; }
  .home-growth-toolbar > a { color: var(--accent); font-weight: 600; text-underline-offset: .2em; }
  .home-growth-history {
    max-height: min(22rem, 38vh);
    overflow-y: auto;
    overflow-x: hidden;
    padding: .5rem .75rem;
    border: 1px solid var(--line);
    overflow-wrap: anywhere;
    background: var(--home-panel-surface, var(--surface));
  }
  @media (pointer: fine) {
    .home-growth-history { scrollbar-width: thin; scrollbar-color: var(--muted) var(--home-panel-surface, var(--surface)); }
  }
  @media (max-width: 800px) {
    .home-growth-history { max-height: min(18rem, 42svh); }
  }

</style>
