---
import Site from "../layouts/Site.astro";
import { url } from "../lib/site";

const destination = url("ai");
const canonical = new URL(destination, Astro.site).toString();
---

<Site showRightSidebar={false}
  title="AIへ移動しました"
  summary="AIの入口は /ai/ へ移動しました。"
  canonical={canonical}
  noindex
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${destination}`} />
  <script is:inline define:vars={{ destination }}>
    location.replace(destination);
  </script>
  <h1>AIへ移動しました</h1>
  <p>AIの入口は新しいURLへ移動しました。</p>
  <p><a href={destination}>AIへ移動する</a></p>
</Site>
