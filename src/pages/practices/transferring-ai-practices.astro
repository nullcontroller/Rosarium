---
import Site from "../../layouts/Site.astro";
import ContentHistory from "../../components/ContentHistory.astro";
import { getEntry } from "astro:content";
import { url } from "../../lib/site";
const entry = await getEntry("pages", "practices/transferring-ai-practices");
const destination = url("practices/transferring-practices");
const canonical = new URL(destination, Astro.site).toString();
---
<Site showRightSidebar={false} title={entry!.data.title} summary="AI活用を別の業務へ横展開するを参照できます。" canonical={canonical} noindex showLastUpdated={false}>
  <meta slot="head" http-equiv="refresh" content={"0;url=" + destination} />
  <script is:inline define:vars={{ destination }}>location.replace(destination);</script>
  <header>
    <h1>{entry!.data.title}</h1>
    <p><a href={destination}>AI活用を別の業務へ横展開するへ移動する</a></p>
    {entry && <ContentHistory id={entry.id} data={entry.data} />}
  </header>
</Site>
