---
import Site from "../../layouts/Site.astro";
import { getEntry } from "astro:content";
import { url } from "../../lib/site";
const entry = await getEntry("pages", "practices/ai-adoption-and-effective-use");
const destination = url("practices");
const canonical = new URL(destination, Astro.site).toString();
---
<Site showRightSidebar={false} title={entry!.data.title} summary="実践知を参照できます。" canonical={canonical} noindex showLastUpdated={false} lastUpdated={entry!.data.last_updated}>
  <meta slot="head" http-equiv="refresh" content={"0;url=" + destination} />
  <script is:inline define:vars={{ destination }}>location.replace(destination);</script>
  <header>
    <h1>{entry!.data.title}</h1>
    <p><a href={destination}>実践知へ移動する</a></p>
  </header>
</Site>

