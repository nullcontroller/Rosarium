---
import Site from "../../layouts/Site.astro";
import { getEntry } from "astro:content";
import { url } from "../../lib/site";
const entry = await getEntry("pages", "practices/transferring-practices");
const destination = url("essays/ai-case-sharing-and-judgment");
const canonical = new URL(destination, Astro.site).toString();
---
<Site showRightSidebar={false} title={entry!.data.title} summary="本記事の知見を連載へ統合しました。" canonical={canonical} noindex showLastUpdated={false}>
  <meta slot="head" http-equiv="refresh" content={"0;url=" + destination} />
  <script is:inline define:vars={{ destination }}>location.replace(destination);</script>
  <header>
    <h1>{entry!.data.title}</h1>
    <p>本記事の知見は連載へ統合しました。</p>
    <p><a href={destination}>AI活用事例は、なぜノウハウにならないのかへ移動する</a></p>
  </header>
</Site>
