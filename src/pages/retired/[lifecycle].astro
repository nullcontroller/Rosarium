---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import PageHeader from "../../components/PageHeader.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import { publishedEntry } from "../../lib/site";
import { archiveLifecycles, isArchiveEntry, getArchiveGroup } from "../../lib/archive";
export function getStaticPaths() {
  return archiveLifecycles.map((group) => ({ params: { lifecycle: group.id }, props: { group } }));
}
const { group } = Astro.props;
const entries = (await getCollection("pages", (entry) => publishedEntry(entry) && isArchiveEntry(entry) && getArchiveGroup(entry) === group.id))
  .sort((a, b) => (b.data.published_at ?? b.data.last_updated).localeCompare(a.data.published_at ?? a.data.last_updated) || a.id.localeCompare(b.id));
---
<Site toc="never" showRightSidebar={false} showReference={false} title={`${group.title}一覧`} summary={group.description} section="retired" noindex>
  <div class="archive-page" data-archive-kind={group.id}>
  <div id="archive-heading"><PageHeader icon={group.icon} title={group.title} summary={group.description} /></div>
  <p>全{entries.length}件。カテゴリを開くと記事を確認できます。</p>
  <ArchiveList entries={entries} lifecycle={group.lifecycle} />
  </div>
</Site>

<style>
.archive-page :global(h1) { color: var(--archive-accent); }
</style>
