---
import Site from "../../layouts/Site.astro";
import { url } from "../../lib/site";

const successor = url("knowledge-context/context-before-model-performance");
const canonical = new URL(successor, Astro.site).toString();
---

<Site
  title="AIの構造とエコシステムの記事を統合しました"
  summary="AIの構造とエコシステムの記事は、Contextを基準にAIを使い分ける後継記事へ統合しました。"
  canonical={canonical}
  noindex
  showLastUpdated={false}
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${successor}`} />
  <script is:inline define:vars={{ successor }}>
    location.replace(successor);
  </script>
  <h1>AIの構造とエコシステムの記事を統合しました</h1>
  <p>
    モデル、Context、Knowledge、権限を分けて考える現在の整理は、後継記事をご覧ください。
  </p>
  <p>
    <a href={successor}>
      「AIを使い分ける基準は、モデル性能よりコンテキストではないか」へ移動する
    </a>
  </p>
</Site>
