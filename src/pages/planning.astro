---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import PageHeader from "../components/PageHeader.astro";
import { activeEntry, url } from "../lib/site";
import { isPlanningKnowledge, planningQuestions, planningPublishedAt } from "../lib/planning";
const articles = (await getCollection("pages", activeEntry)).filter(isPlanningKnowledge);
const headings = [
  { depth: 2, slug: "reading", text: "企画の判断を考える" },
  { depth: 2, slug: "scope", text: "企画で決めること" },
  { depth: 2, slug: "purpose", text: "この領域を深める理由" },
  { depth: 2, slug: "field-work", text: "FDEとの関係" },
];
---
<Site title="企画" section="planning" publishedAt={planningPublishedAt} headings={headings}>
  <PageHeader alignHero navigationPath="planning" title="企画" eyebrow="SYSTEM PLANNING" summary="何を、なぜ、どこまでシステム化するのか。業務課題から目的・期待価値・業務要件・業務目標を整理し、対象範囲と投資の優先順位を判断します。" />
  <p>企画で定めた業務要求を、<a href={url("ai-design")}>AI設計</a>でシステム要件・実現方式・責任分担へ具体化します。<a href={url("dx")}>DX</a>は業務・価値・組織の変化を扱います。企画では新規開発だけでなく、既存システムの刷新・廃止や、システムを作らない選択も検討します。</p>
  <section aria-labelledby="reading">
    <h2 id="reading">企画の判断を考える</h2>
    <ul class="dx-featured-articles">{articles.map(entry => <li><h3><a href={url(entry.id)}>{entry.data.title}</a></h3><p>{entry.data.summary}</p></li>)}</ul>
  </section>
  <section aria-labelledby="scope">
    <span id="handoff" aria-hidden="true"></span>
    <h2 id="scope">企画で決めること</h2>
    <ul>{planningQuestions.map(question => <li><strong>{question.title}</strong><p>{question.description}</p></li>)}</ul>
  </section>
  <section aria-labelledby="purpose">
    <h2 id="purpose">この領域を深める理由</h2>
    <p>私は、与えられた課題をどうシステム化するかだけでなく、何を変える価値があるのかを見つけるところから関わりたいと考えています。価値を確かめ、業務要件とシステム化範囲を定める判断を、今後の専門領域として深めたいと思っています。</p>
    <p>ここでは、そのための知識と判断原則を整理しています。現在、公開中の企画事例はありません。</p>
  </section>
  <section aria-labelledby="field-work">
    <h2 id="field-work">FDEとの関係</h2>
    <p>FDEは、現場理解から要件定義・設計・PoC・実装・改善を横断し得る働き方です。企画と重なる部分はありますが、企画では「何を変える価値があるか」を起点に、業務目標・優先順位・対象範囲を定める判断に焦点を当てます。</p>
  </section>
</Site>
