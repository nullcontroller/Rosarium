---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import PageHeader from "../components/PageHeader.astro";
import { publishedEntry, url } from "../lib/site";
import { archiveLifecycles, isArchiveEntry } from "../lib/archive";
const entries = await getCollection("pages", (entry) => publishedEntry(entry) && isArchiveEntry(entry));
---
<Site title="退役記事" section="retired" noindex lastUpdated="2026-10-05" summary="現在の推奨ではない旧記事と、役割を終えた退役記事を確認するKnowledge Lifecycleの入口。" breadcrumbs={[{ name: "Rosarium", path: "" }, { name: "退役記事", path: "retired" }]}>
  <div class="archive-page">
  <PageHeader title="退役記事" />
  <p>現在の推奨ではないコンテンツと、独立した役割を終えた記録を、位置づけごとに保存しています。</p>
  <div class="archive-entrances">
    {archiveLifecycles.map((group) => <a href={url(`retired/${group.lifecycle}`)} data-archive-entrance={group.lifecycle}>
      <span>{group.lifecycle.toUpperCase()}</span>
      <h2>{group.title}</h2>
      <p>{group.description}</p>
      <small>{entries.filter((entry) => entry.data.lifecycle === group.lifecycle).length}件</small>
    </a>)}
  </div>
  </div>
</Site>
<style>
.archive-entrances { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 2rem; }
.archive-entrances a { padding: 1.5rem; background: var(--obsolete-bg); border: 1px solid var(--obsolete-line); color: var(--obsolete-ink); text-decoration: none; overflow-wrap: anywhere; }
.archive-entrances h2 { color: inherit; margin: .5rem 0; }
.archive-entrances p { line-height: 1.75; }
.archive-entrances small, .archive-entrances span { color: var(--obsolete-muted); }
.archive-entrances a:hover { border-color: var(--obsolete-hover); }
.archive-entrances a:focus-visible { outline: 2px solid var(--obsolete-hover); outline-offset: 4px; }
.archive-entrances a[data-archive-entrance="retired"] { border-style: dashed; }
@media (max-width: 640px) { .archive-entrances { grid-template-columns: 1fr; } }
</style>

<style>
.archive-page :global(h1) { color: var(--obsolete-ink); }
</style>
