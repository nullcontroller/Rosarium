---
import Site from "../layouts/Site.astro";
import PageHeader from "../components/PageHeader.astro";
import { url } from "../lib/site";
import { readingCategories } from "../lib/navigation";
---

<Site title="AI" section="ai">
  <PageHeader icon="articles" title="AI" />

  <section class="reading-domain" aria-labelledby="ai-reading-heading">
    <p class="eyebrow">PRIMARY DOMAIN</p>
    <h2 id="ai-reading-heading">AIについて何を考えているか</h2>
    <p>
      AIの性質だけでなく、使う目的、責任境界、業務への組み込み方、導入後の評価と改善までを扱います。
    </p>
    <p>
      知りたいことに近い問いから選べます。
    </p>
    <div class="reading-directory">
      {readingCategories.filter((category) => category.path !== "cases").map((category) => (
        <section class="reading-area" id={category.path}>
          <div>
            <h3 class="reading-question">
              <a href={url(category.path)}>{category.question}</a>
            </h3>
            <p class="reading-category">{category.title}</p>
            <p>{category.summary}</p>
          </div>
        </section>
      ))}
    </div>
  </section>

  <nav class="secondary-reading" aria-label="AIコンテンツの補助的な入口">
    <p class="eyebrow">OTHER PATHS</p>
    <a href={url("start-here")}>はじめに</a>
    <a href={url("essays")}>考察</a>
  </nav>
</Site>
