---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import PageHeader from "../components/PageHeader.astro";
import DomainThemeSection from "../components/DomainThemeSection.astro";
import { aiThemeGroups } from "../lib/ai";
import { activeEntry, url } from "../lib/site";
const entries = await getCollection("pages", activeEntry);
const groups = aiThemeGroups(entries);
const headings = [
  ...groups.map((theme) => ({ depth: 2, slug: theme.id, text: theme.title })),
];
---

<Site title="AI・数理" section="ai" headings={headings}>
  <PageHeader alignHero navigationPath="ai" title="AI・数理" />
  <p>業務・組織での活用は<a href={url("dx")}>DX</a>、RAG・評価・HITLなどの実現方式は<a href={url("system-design")}>システム設計</a>、導入目的や投資の判断は<a href={url("planning")}>IT戦略・企画</a>で扱います。</p>
  <section class="dx-category-list" aria-label="AIのテーマ別記事">
    <span id="ai-themes-heading" aria-hidden="true"></span>
    {groups.map((theme) => <DomainThemeSection {...theme} domain="ai" />)}
  </section>

</Site>
