---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import ContentIndex from "../components/ContentIndex.astro";
import { activeEntry, url } from "../lib/site";
import PageHeader from "../components/PageHeader.astro";
import { referenceEntries } from "../lib/reference";
const entries = referenceEntries(await getCollection("pages", activeEntry));
---

<Site title="Reference" section="reference" showRightSidebar={false}>
  <PageHeader icon="reference" title="Reference" />
  <p>
    数学的定義、観測から計算する指標、関係を単純化した説明モデル、実装と評価で確かめる設計仮説を区別して扱います。
  </p>
  <ContentIndex entries={entries} />
  <p><a href={url("foundations/glossary")}>Reference索引</a></p>
</Site>
