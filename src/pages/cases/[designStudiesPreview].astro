---
import Site from "../../layouts/Site.astro";
import PageHeader from "../../components/PageHeader.astro";
import { url } from "../../lib/site";
import { getCollection } from "astro:content";
import { isDraftPreview } from "../../lib/draft-preview.mjs";
import { selectedDesignStudies } from "../../data/design-studies.mjs";
import ContentLink from "../../components/ContentLink.astro";
export function getStaticPaths() {
  return process.env.ROSARIUM_DRAFT_PREVIEW
    ? [{ params: { designStudiesPreview: "design-studies" } }]
    : [];
}
const entries = await getCollection("pages", entry => isDraftPreview(entry, process.env.ROSARIUM_DRAFT_PREVIEW));
const studies = selectedDesignStudies(process.env.ROSARIUM_DRAFT_PREVIEW)
  .filter(study => entries.some(entry => entry.id === study.id));
---
<Site title="実務から広げるシステム設計ケーススタディ" section="cases" noindex internalSearch={false}>
  <PageHeader title="実務から広げるシステム設計ケーススタディ" />
  <p role="note">レビュー用初稿です。記事の公開判断前であり、本番サイトには掲載していません。</p>
  <p>実務事例で得た知見を出発点に、異なる制約や追加要件を設定して検討する仮想設計です。実際の追加開発や本番運用の実績を示すものではありません。</p>
  <section>
    <h2>起点となる実務事例</h2>
    <p><a href={url("cases/customer-support-ai-dx")}>生成AI / RAGによる顧客サポートDX</a></p>
    <p>実務Bookは業務・設計・PoCを扱います。本番運用での効果確認とは区別し、この先の設計検討ではケースごとに追加する前提条件を示します。</p>
  </section>
  <section>
    <h2>なぜ、このケーススタディを考えたのか</h2>
    <p>起点となる実務では、第1回PoCで確認した課題に対し、RAG管理システムを新規構築し、製品・版数・利用環境のメタデータで検索対象を制御しました。第2回PoCでは回答正答率が72％から96％へ改善し、設定した目標を達成しました。これはPoCにおける回答・対応結果の評価であり、検索文書だけの適合率とは区別します。本番運用での効果確認は行っていません。</p>
    <p>この経験から、検索へ渡す情報の管理と、自動回答・有人対応の境界をどう設計するかという問いが生まれました。その知見を、さらに多くの文書を扱う場合、既存業務から切り替える場合、文書が改訂され続ける場合へ広げると、どのような判断が必要になるのでしょうか。</p>
    <p>以下の6ケースでは、業務分析、バッチ処理、テスト、移行、セキュリティ、改訂管理ごとに仮想条件を加えています。実務で確認したのはBookに記した業務・設計・PoCの範囲であり、各ケースの追加条件や処理例、評価計画は、別の条件のもとで考えた設計検討です。実際の追加開発や本番運用の実績とは区別します。</p>
  </section>
  <section>
    <h2>業務の場面から選ぶ</h2>
    {studies.length === 0 && <p>このレビューでは個別記事が選択されていません。</p>}
    {studies.map(study => <section>
      <p class="meta">{study.area}</p>
      <ContentLink entry={entries.find(entry => entry.id === study.id)!} heading="h3" />
      <dl>
        <dt>このケースの問い</dt><dd>{study.question}</dd>
        <dt>どのように進めるか</dt><dd>{study.decision}</dd>
      </dl>
    </section>)}
  </section>
  <section>
    <h2>ケース間の関係と読み方</h2>
    <p>どの質問をAIへ任せるか迷うなら問い合わせ分析、大量のマニュアルを登録するならバッチ、切替準備を考えるなら移行から読めます。回答を試すのがテスト、社内情報を渡さないための設計がセキュリティ、マニュアルの一部改訂を追うのが更新管理です。</p>
    <p>全記事を順番に読む必要はありません。各ケースは背景と制約から独立して読めます。方式や数値の条件は記事ごとに異なり、一つの導入計画や実績として統合しません。</p>
    <p>FDEは現場分析からシステム設計・継続運用を横断する総合ケースの候補です。現時点の公開記事ではありません。</p>
    <p><a href={url("cases")}>実践事例の一覧へ戻る</a></p>
  </section>
</Site>
