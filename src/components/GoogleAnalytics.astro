---
const measurementId = "G-W5ZR0NKWGB";
interface Props {
  page: Record<string, string>;
  enabled?: boolean;
}
const { page, enabled = true } = Astro.props;
---

{import.meta.env.PROD && (
  <>
    <script is:inline data-analytics-init define:vars={{ measurementId, page, enabled }}>
      function shouldLoadAnalytics() {
        // This is a conservative pre-load guard, not complete bot detection.
        const automatedAgent = /\b(?:bot|crawler|spider|headless(?:chrome)?|lighthouse|pagespeed|googlebot|bingbot|applebot|slackbot|facebookexternalhit|linkpreview)\b|\b[a-z0-9_-]*(?:bot|crawler|spider|preview)\//i;
        return enabled && window.location.hostname === 'rosarium-tech.com' &&
          window.location.protocol === 'https:' &&
          navigator.webdriver !== true &&
          !automatedAgent.test(navigator.userAgent);
      }
      if (shouldLoadAnalytics()) {
      // Never forward arbitrary query/hash values; retain only campaign identifiers.
      const pageLocation = new URL(window.location.pathname, 'https://rosarium-tech.com');
      const query = new URLSearchParams(window.location.search);
      for (const key of ['utm_source', 'utm_medium', 'utm_campaign']) {
        const value = query.get(key);
        if (value && /^[a-z0-9_-]{1,80}$/i.test(value)) pageLocation.searchParams.set(key, value);
      }
      let referrer = '';
      try { referrer = document.referrer ? new URL(document.referrer).origin + '/' : ''; } catch {}
      const parameters = { ...page, page_location: pageLocation.href, page_referrer: referrer };
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', measurementId, { ...parameters, send_page_view: false });
      window.gtag('event', 'page_view', { ...parameters, send_to: measurementId });
      const loader = document.createElement('script');
      loader.async = true;
      loader.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(loader);
      }
    </script>
  </>
)}
