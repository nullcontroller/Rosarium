---
import type { CollectionEntry } from "astro:content";
import { visibleDesignStudies } from "../lib/design-study-discovery";
import { designStudyGroups } from "../data/design-studies.mjs";
interface Props {
  entries: CollectionEntry<"pages">[];
  caseId: string;
  heading?: "h2" | "h3" | "h4";
}
const { entries, caseId, heading: Heading = "h2" } = Astro.props;
const group = designStudyGroups.find(group => group.caseId === caseId);
const studies = visibleDesignStudies(entries, caseId);
const isVisible = (entry: CollectionEntry<"pages">) => entry.data.public !== false &&
  ["published", "stable"].includes(entry.data.status) && (!entry.data.lifecycle || entry.data.lifecycle === "active");
const source = entries.find(entry => entry.id === caseId && isVisible(entry));
const id = `design-studies-${caseId.replaceAll("/", "-")}`;
---
{group && source && studies.length > 0 && <section class="design-studies-gateway" data-design-studies-gateway data-design-studies-source={caseId} data-toc-exclude aria-labelledby={id}>
  <Heading id={id}><a href={group.listingTarget}>仮想設計</a></Heading>
  <p>{group.summary}</p>
</section>}
<style>
  .design-studies-gateway { margin: 1rem 0; padding: .75rem 0; border-top: 1px solid var(--line); }
  .design-studies-gateway :is(h2, h3, h4) { margin: 0 0 .3rem; font-size: 1.25rem; }
  .design-studies-gateway :is(h3, h4) { font-size: 1.05rem; }
  .design-studies-gateway a { white-space: nowrap; }
  .design-studies-gateway p { margin: 0; }
</style>
