---
interface Props { collapsible?: boolean; }
const { collapsible = true } = Astro.props;
---
{collapsible && <button type="button" class="right-sidebar-toggle" data-right-sidebar-toggle aria-controls="right-sidebar" aria-expanded="true" aria-label="補助パネルを閉じる" title="補助パネルを閉じる">補助パネルを閉じる</button>}
<script>
(() => {
  const host = document.querySelector<HTMLElement>("#right-sidebar");
  if (!host || host.dataset.collapsible === "false") return;
  const desktop = matchMedia("(min-width: 1440px)");
  const railStorageKey = "rosarium-right-sidebar-closed";
  let railClosed = false;
  try { railClosed = localStorage.getItem(railStorageKey) === "true"; } catch {}
  const railButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-right-sidebar-toggle]")];
  function setRailClosed(closed: boolean, persist = true) {
    if (!host) return;
    railClosed = closed;
    if (persist) { try { localStorage.setItem(railStorageKey, String(closed)); } catch {} }
    const scroll = window.scrollY;
    const hidden = desktop.matches && closed;
    const hadFocus = host.contains(document.activeElement);
    host.hidden = hidden;
    host.closest(".shell")?.classList.toggle("right-sidebar-collapsed", hidden);
    railButtons.forEach((button) => {
      const label = hidden ? "補助パネルを開く" : "補助パネルを閉じる";
      button.textContent = label;
      button.setAttribute("aria-label", label);
      button.title = label;
      button.setAttribute("aria-expanded", String(!hidden));
    });
    if (hadFocus && hidden) document.querySelector<HTMLButtonElement>(".right-sidebar-toggle")?.focus({ preventScroll: true });
    window.scrollTo({ top: scroll, behavior: "instant" });
  }
  railButtons.forEach((button) => button.addEventListener("click", () => {
    setRailClosed(!railClosed);
  }));
  setRailClosed(railClosed, false);
  desktop.addEventListener("change", () => setRailClosed(railClosed, false));
  document.addEventListener("right-sidebar-open", () => setRailClosed(false));
})();
</script>

<style is:global>
.reference-tabs { display: flex; gap: .25rem; flex: 0 0 auto; border-bottom: 1px solid var(--line); margin-bottom: .75rem; }
.reference-tabs button { border: 0; border-bottom: 2px solid transparent; padding: .6rem .3rem; min-height: 44px; font: inherit; font-size: .85rem; color: var(--muted); background: transparent; cursor: pointer; white-space: nowrap; }
.reference-tabs button[aria-selected="true"] { border-bottom-color: var(--accent); color: var(--ink); }
.reference-tabs button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.page-toc-panel[hidden] { display: none; }
@media (min-width: 1440px) {
  .reference-sidebar { padding-right: 2.5rem; display: flex; flex-direction: column; height: calc(100dvh - 88px); overflow: hidden; }
  .page-toc-panel { min-height: 0; overflow-y: auto; }
}
</style>
<style is:global>
.right-sidebar-toolbar { display: flex; align-items: start; gap: .25rem; }
.right-sidebar-toolbar .reference-tabs { flex: 1; min-width: 0; }
.right-sidebar-toggle { position: fixed; top: 50%; right: 0; transform: translateY(-50%); z-index: 45; writing-mode: vertical-rl; width: 2rem; height: 14rem; display: flex; align-items: center; justify-content: center; padding: .75rem .4rem; border: 1px solid var(--line); border-right: 0; background: var(--surface); color: var(--ink); cursor: pointer; font-size: .8125rem; }
.reference-sidebar[hidden], .right-sidebar-toggle[hidden] { display: none !important; }
[data-right-sidebar-toggle]:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
@media (min-width: 1440px) {
  body .shell.right-sidebar-collapsed, body .shell.reference-wide.right-sidebar-collapsed { grid-template-columns: var(--left-rail-width) minmax(0, 1fr); }
}
@media (max-width: 1439px) { .right-sidebar-toggle { display: none !important; } }
@media print { .right-sidebar-toggle { display: none !important; } }
</style>
