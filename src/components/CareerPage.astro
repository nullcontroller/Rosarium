---
import { getEntry, render } from "astro:content";
import Site from "../layouts/Site.astro";
import { splitRelatedContent, careerCaseLinks } from "../lib/related-content.mjs";
import MarkdownBody from "./MarkdownBody.astro";
import { url } from "../lib/site";
import { statusLabel } from "../lib/site";
import Icon from "./Icon.astro";
interface Props {
  id: "overview" | "details";
}
const entry = await getEntry("career", Astro.props.id);
if (!entry) throw new Error("Career content missing");
const { headings } = await render(entry);
const d = entry.data;
const content = splitRelatedContent(entry.rendered?.html || "");
const caseLinks = careerCaseLinks(content.related);
const isOverview = Astro.props.id === "overview";
const linkedIn =
  "https://www.linkedin.com/in/%E8%A3%95%E5%A4%AA%E6%9C%97-%E7%AB%8B%E6%9E%97-99076b352/";
---

<Site
  title={d.seo_title ?? d.title}
  summary={d.summary}
  ogImage="og/career.png"
  ogType="profile"
  section="career"
  lastUpdated={d.last_updated}
  headings={headings}
  frame={false}
  breadcrumbs={[
    { name: "庭", path: "" },
    { name: "キャリア", path: "career" },
    ...(!isOverview ? [{ name: "経験と実践", path: "career/details" }] : []),
  ]}
>
  <nav class="breadcrumb" aria-label="現在位置">
    <a href={url()}>Rosarium</a> / <a href={url("career")}>キャリア</a>
    {!isOverview && (
      <>
        {" "}
        / <span>経験と実践</span>
      </>
    )}
  </nav>
  <article data-pagefind-body>
    <div class="document-title-row">
      <Icon name="career" size="page" />
      <h1 data-pagefind-meta="title">{d.title}</h1>
    </div>
    <span hidden data-pagefind-meta="icon">
      career
    </span>

    <p class="lead" data-pagefind-meta="summary">
      {d.summary}
    </p>

    <p hidden>
      <span data-pagefind-meta="category">キャリア</span> ·{" "}
      <span data-pagefind-meta="status">{statusLabel(d.status)}</span>
    </p>
    <div class="prose">
      <MarkdownBody html={content.body} />
    </div>
  </article>
  <section class="content-related" aria-label="関連する内容" data-related-content>
    <h2>関連する内容</h2>
    <ul class="reading-exit-links career-case-links">
      {caseLinks.map((link) => <li><a href={link.href}>{link.title}</a><p class="meta">{link.summary}</p></li>)}
    </ul>
    <nav class="career-actions" aria-label="キャリアの主要導線">
      <a
        class="action-link"
        href={url(isOverview ? "career/details" : "career")}
      >
        {isOverview ? "経験と実践の背景を見る" : "仕事の考え方へ戻る"}
      </a>
      <a class="action-link" href={linkedIn}>LinkedInで職歴・資格を見る</a>
      {!isOverview && <a class="action-link" data-implementation-link href="https://github.com/nullcontroller/Rosarium">サイトの実装を見る</a>}
    </nav>

  </section>
</Site>
