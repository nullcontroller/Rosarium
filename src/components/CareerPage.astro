---
import { getEntry, render } from "astro:content";
import Site from "../layouts/Site.astro";
import MarkdownBody from "./MarkdownBody.astro";

import { statusLabel, publicEntry } from "../lib/site";
import Icon from "./Icon.astro";
const entry = await getEntry("career", "overview");
if (!entry) throw new Error("Career content missing");
// This summary must be shipped atomically with the expanded investigation Book.
if (entry.body?.includes('data-career-case="ai-technical-investigation"')) {
  const book = await getEntry("pages", "cases/ai-technical-investigation");
  const finalChapter = await getEntry("pages", "cases/ai-technical-investigation/reusable-method");
  if (!book || !finalChapter || !publicEntry(book) || !publicEntry(finalChapter) || !book.data.summary.includes("2人日")) {
    throw new Error("Career investigation outcome requires the published nine-chapter investigation Book in the same build.");
  }
}
const { headings } = await render(entry);
const d = entry.data;
---

<Site
  title={d.seo_title ?? d.title}
  analyticsTitle={d.title}
  summary={d.summary}
  ogImage="og/career.png"
  ogType="profile"
  section="career"
  lastUpdated={d.last_updated}
  headings={headings}
>
  <article data-pagefind-body>
    <div class="document-title-row">
      <Icon name="career" size="page" />
      <h1 data-pagefind-meta="title">{d.title}</h1>
    </div>
    <span hidden data-pagefind-meta="icon">
      career
    </span>

    <p class="lead" data-pagefind-meta="summary">
      {d.summary}
    </p>

    <p hidden>
      <span data-pagefind-meta="category">キャリア</span>
      <span data-pagefind-meta="content_kind">キャリア</span> ·{" "}
      <span data-pagefind-meta="status">{statusLabel(d.status)}</span>
      <span data-pagefind-meta="last_updated">{d.last_updated}</span>
    </p>
    <div class="prose">
      <MarkdownBody html={entry.rendered?.html || ""} />
    </div>
  </article>
</Site>

<style>
  .prose :global(.career-case-grid) { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,22rem),1fr)); gap:1rem; align-items:start; margin-block:1rem 1.5rem; }
  .prose :global(.career-case) { min-width:0; padding:1rem; border:1px solid var(--line); border-radius:.35rem; background:var(--surface); }
  .prose :global(.career-case .career-domain) { margin:0 0 .4rem; color:var(--muted); }
  .prose :global(.career-case h3) { margin:0 0 .75rem; font-size:1.2rem; line-height:1.5; }
  .prose :global(.career-case dl) { margin:0; }
  .prose :global(.career-case dt) { font-weight:600; margin-top:.6rem; }
  .prose :global(.career-case dd) { margin: .15rem 0 0; }
  .prose :global(.career-case .career-result strong) { color:var(--accent); }
  .prose :global(.career-result span) { display:block; margin-top:.2rem; }
  .prose :global(.career-case .career-case-link) { margin:.65rem 0 0; }
  .prose :global(.career-case-link a) { display:inline-flex; align-items:center; min-height:44px; font-weight:600; }
</style>
