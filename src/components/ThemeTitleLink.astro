---
import { url } from "../lib/site";
interface Props { path: string; title: string; }
const { path, title } = Astro.props;
---
<a class="theme-title-link" href={url(path)}>{title}<span aria-hidden="true">→</span></a>
<style>
  .theme-title-link { display: inline-flex; align-items: baseline; gap: .5rem; max-width: 100%; color: inherit; font: inherit; text-underline-offset: .2em; }
  .theme-title-link span { flex: none; font-size: .8em; }
  .theme-title-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
</style>
