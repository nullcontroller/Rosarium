---
import { getEntry } from "astro:content";
import { publishedEntry } from "../lib/site";
import type { RecentGrowthItem } from "../data/recent-growth";
import {
  recentGrowthDateLabel,
  recentGrowthLabels,
  growthChangeTargets,
  growthSummary,
} from "../data/recent-growth";
import Icon from "./Icon.astro";

interface Props { entry: RecentGrowthItem; }
const { entry } = Astro.props;
const cases = new Set<string>();
for (const id of entry.changes.flatMap(growthChangeTargets)) {
  const content = await getEntry("pages", id);
  if (!content || !publishedEntry(content)) throw new Error("History target is not published: " + id);
  if (content.data.kind === "case" || content.data.layer === "case" || content.data.section === "cases") cases.add(id);
}
const summaries = growthSummary(entry, id => cases.has(id));
---

<article class="growth-entry icon-entry" data-growth-entry data-growth-date={entry.date}>
  <Icon name={entry.icon ?? "updates"} size="list" />
  <div>
    <p class="meta growth-meta">
      <time datetime={entry.date}>{recentGrowthDateLabel(entry.date)}</time>
      <span class={`update-badge update-${entry.type}`}>
        {recentGrowthLabels[entry.type]}
      </span>
      <span>{entry.category}</span>
    </p>
    <h3 class="content-title">
      {entry.title}
    </h3>
    <ul class="growth-changes content-summary" role="list">
      {summaries.map(text => <li>{text}</li>)}
    </ul>
  </div>
</article>
