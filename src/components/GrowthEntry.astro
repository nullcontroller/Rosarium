---
import type { RecentGrowthItem } from "../data/recent-growth";
import {
  recentGrowthDateLabel,
  recentGrowthLabels,
} from "../data/recent-growth";
import Icon from "./Icon.astro";

interface Props {
  entry: RecentGrowthItem;
  maxChanges?: number;
}

const { entry, maxChanges } = Astro.props;
const changes = maxChanges === undefined ? entry.changes : entry.changes.slice(0, maxChanges);
---

<article class="growth-entry icon-entry" data-growth-entry>
  <Icon name={entry.icon ?? "updates"} size="list" />
  <div>
    <p class="meta growth-meta">
      <time datetime={entry.date}>{recentGrowthDateLabel(entry.date)}</time>
      <span class={`update-badge update-${entry.type}`}>
        {recentGrowthLabels[entry.type]}
      </span>
      <span>{entry.category}</span>
    </p>
    <h3 class="content-title">
      {entry.title}
    </h3>
    <ul class="growth-changes content-summary" role="list">
      {changes.map((change) => <li>{change}</li>)}
    </ul>
  </div>
</article>
