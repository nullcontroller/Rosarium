---
import { caseDiagrams } from "../data/case-diagrams";
import "../styles/case-diagrams.css";
interface Props { id?: string; }
const { id = "support-overview" } = Astro.props;
const model = caseDiagrams[id];
const explanation = model?.explanation;
if (!explanation) throw new Error(`Unknown support explanation: ${id}`);
const sentenceLines = (text: string) => text.replaceAll("。", "。\n").trim();
const isOverview = id === "support-overview";
const nodeById = new Map(model.nodes.map(node => [node.id, node]));
const prefix = isOverview ? "support-dx-flow" : `case-${id}`;
const oldAnchors: Record<string, string> = { customer: "customer", search: "rag", answer: "genai", decision: "decision" };
---

<figure class="case-diagram support-explanation" id={prefix} data-explanation-id={id}
  data-support-dx={isOverview ? "" : undefined} data-case-flow={!isOverview ? "" : undefined}
  aria-labelledby={`${prefix}-title`}>
  <figcaption id={`${prefix}-title`}>{model.title}</figcaption>
  <p class="support-purpose">{sentenceLines(model.description)}</p>
  {explanation.format === "table" && (
    <table class="support-table" aria-labelledby={`${prefix}-title`}>
      <thead><tr>{explanation.columns!.map(column => <th scope="col">{column}</th>)}</tr></thead>
      <tbody>{explanation.records!.map(record => <tr>{record.map((cell, index) => index === 0 ?
        <th scope="row">{cell}</th> : <td><span class="support-cell-label" aria-hidden="true">{explanation.columns![index]}</span>{cell}</td>)}</tr>)}</tbody>
    </table>
  )}
  {explanation.panels && (
    <div class:list={["support-panels", explanation.format === "comparison" && "support-comparison"]}>
      {explanation.panels.map(panel => (
        <section class="support-panel" aria-label={panel.title}>
          <p class="support-panel-title">{panel.title}</p>
          <ol class="support-steps">
            {panel.nodeIds.map((nodeId, index) => {
              const node = nodeById.get(nodeId)!;
              return <li>
                <div class="support-step" data-kind={node.kind} data-support-step={nodeId}
                  id={isOverview && oldAnchors[nodeId] ? `support-detail-${oldAnchors[nodeId]}` : undefined}>
                  <p class="support-action">{node.label}</p>
                  <p class="support-description">{sentenceLines(node.description)}</p>
                </div>
                {index < panel.nodeIds.length - 1 && <span class="support-connector" aria-hidden="true">↓</span>}
              </li>;
            })}
          </ol>
          {panel.outcomes && <dl class="support-outcomes" aria-label="判定後の行き先">
            {panel.outcomes.map((outcome, index) => <div id={isOverview ? `support-detail-${index ? "human" : "response"}` : undefined}>
              <dt>{outcome.condition}</dt><dd>{outcome.result}</dd>
            </div>)}
          </dl>}
        </section>
      ))}
    </div>
  )}
  {explanation.checks && (
    <ol class="support-checks">
      {explanation.checks.map((check, index) => <li>
        <div class="support-step support-question">
          <p class="support-action">{check.question}</p>
          <dl class="support-branches">
            <div><dt>はい</dt><dd>{check.yes}</dd></div>
            <div><dt>いいえ</dt><dd>{check.no}</dd></div>
          </dl>
        </div>
        {index < explanation.checks!.length - 1 && <span class="support-connector" aria-hidden="true">はい ↓</span>}
      </li>)}
    </ol>
  )}
  {explanation.outcomes && <dl class="support-outcomes" aria-label="判定結果">
    {explanation.outcomes.map(outcome => <div><dt>{outcome.condition}</dt><dd>{outcome.result}</dd></div>)}
  </dl>}
  <p class="support-note" id={isOverview ? "support-detail-knowledge" : undefined}>{sentenceLines(explanation.note)}</p>
  <p class="support-scope" id={isOverview ? "support-detail-feedback" : undefined}>{sentenceLines(explanation.scope)}</p>
</figure>
