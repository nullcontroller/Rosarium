---
/** Static links and explanations are enhanced in-place; both layouts share one model. */
const nodes = [
  {
    id: "customer",
    label: "顧客・質問",
    sub: "必要な条件を確認",
    description:
      "顧客の質問から、製品・機種・OS・エラーなどの条件を確認します。条件を特定できない場合は人へ引き継ぎます。",
  },
  {
    id: "knowledge",
    label: "回答の知識",
    sub: "Knowledge",
    description:
      "製品・版・公開可否・有効性を確認した知識を管理します。検索できる文書すべてを、顧客への回答根拠にしてよいわけではありません。",
  },
  {
    id: "rag",
    label: "根拠を検索",
    sub: "RAG",
    description:
      "機種・OS・エラーなどの条件で、公開可能なKnowledgeから回答根拠を検索します。対象や版が異なる根拠は使いません。",
  },
  {
    id: "genai",
    label: "生成AI",
    sub: "根拠から回答案を生成",
    description:
      "取得した根拠の範囲で回答案を生成します。流暢な文章が出たこと自体は、正しさの保証になりません。",
  },
  {
    id: "decision",
    label: "回答条件の判定",
    sub: "システムで条件を確認",
    description:
      "根拠・対象・公開可否・影響度をシステムで確認します。不足・矛盾・専門判断があれば人へ渡し、AI自身の自信だけでは決めません。",
  },
  {
    id: "human",
    label: "人による確認",
    sub: "専門判断・有人引継ぎ",
    description:
      "根拠が足りない、または専門判断が必要な場合に人へ引き継ぎます。質問・条件・根拠・停止理由を受け取り、人が最終的な業務責任を持ちます。",
  },
  {
    id: "response",
    label: "顧客へ回答",
    sub: "条件を満たす場合",
    description:
      "条件を満たしたAIの回答、または人が判断した案内を顧客へ届けます。権限や取引などの確定処理は既存システムが担います。",
  },
  {
    id: "feedback",
    label: "改善",
    sub: "利用結果を次回へ反映",
    description:
      "誤回答や有人対応結果を確認し、Knowledge・検索条件・評価方法を改善します。変更後は再評価し、次回の検索・回答へ反映します。",
  },
];
const layouts = [
  {
    name: "desktop",
    viewBox: "0 0 840 410",
    width: 164,
    positions: [
      [20, 40],
      [230, 180],
      [230, 40],
      [440, 40],
      [650, 40],
      [650, 180],
      [440, 300],
      [230, 300],
    ],
    paths: [
      "M184 76H230",
      "M312 180V112",
      "M394 76H440",
      "M604 76H650",
      "M710 112V140H522V300",
      "M760 112V180",
      "M732 252V336H604",
      "M440 336H394",
      "M312 300V252",
    ],
    labels: [
      [530, 160, "回答条件を満たす"],
      [765, 160, "人へ引継ぎ"],
      [55, 285, "知識・検索・評価を改善"],
    ],
  },
  {
    name: "mobile",
    viewBox: "0 0 320 560",
    width: 232,
    positions: [
      [44, 10],
      [8, 90],
      [174, 90],
      [44, 182],
      [44, 258],
      [8, 362],
      [174, 362],
      [12, 464],
    ],
    // Flow, split and improvement are separate blocks, not equal-sized steps.
    sizes: [
      [232, 56],
      [138, 64],
      [138, 64],
      [232, 56],
      [232, 60],
      [138, 72],
      [138, 72],
      [296, 86],
    ],
    paths: [
      "M160 66V78H243V90",
      "M146 122H174",
      "M243 154V168H160V182",
      "M160 238V258",
      "M160 318V338H243V362",
      "M160 318V338H77V362",
      "M146 398H174",
      "M243 434V452H160V464",
    ],
    labels: [
      [14, 82, "知識と検索"],
      [12, 354, "有人対応"],
      [247, 354, "AIで完結"],
    ],
  },
];
---

<figure class="support-dx" id="support-dx-flow" data-support-dx>
  <figcaption>問い合わせ対応の分岐と改善の流れ</figcaption>
  <p class="diagram-help">図の項目から、役割と判断条件の説明へ移動できます。</p>
  {layouts.map((layout) => (
    <svg
      class={`diagram-${layout.name}`}
      viewBox={layout.viewBox}
      role="group"
      aria-labelledby={`support-${layout.name}-title support-${layout.name}-desc`}
    >
      <title
        id={`support-${layout.name}-title`}
      >顧客サポートDX：AIで回答する経路と人へ引き継ぐ経路</title>
      <desc id={`support-${layout.name}-desc`}>
        顧客の質問に対し、KnowledgeからRAGで根拠を検索し、生成AIが回答案を作ります。システムの回答条件を満たすものは回答へ、根拠不足や専門判断が必要なものは人間へ引き継ぎます。利用結果と有人対応結果を知識・検索条件・評価の改善へ戻します。
      </desc>
      <defs>
        <marker
          id={`support-arrow-${layout.name}`}
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0 0L10 5L0 10Z" />
        </marker>
      </defs>
      <g class="flow-lines" aria-hidden="true">
        {layout.paths.map((path, index) => (
          <path
            class:list={[
              layout.name === "desktop" &&
                index === layout.paths.length - 1 &&
                "feedback-path",
            ]}
            d={path}
            marker-end={`url(#support-arrow-${layout.name})`}
          />
        ))}
      </g>
      <g class="flow-labels" aria-hidden="true">
        {layout.labels.map(([x, y, text]) => (
          <text x={x} y={y}>
            {text}
          </text>
        ))}
      </g>
      {nodes.map((node, index) => {
        const [x, y] = layout.positions[index];
        const [width, height] =
          layout.name === "mobile" && layout.sizes
            ? layout.sizes[index]
            : [layout.width, 72];
        const mobile = layout.name === "mobile";
        const feedback = mobile && node.id === "feedback";
        const nodeLabel =
          mobile && node.id === "customer" ? "質問" : node.label;
        const nodeSub =
          mobile && node.id === "human" ? "専門判断・引継ぎ" : node.sub;
        return (
          <a
            href={`#support-detail-${node.id}`}
            data-node={node.id}
            data-kind={node.id}
            aria-label={`${node.label}：${node.sub}。説明を読む`}
            style={`--step:${index}`}
          >
            <rect
              x={x}
              y={y}
              width={width}
              height={height}
              rx={node.id === "decision" ? 22 : 8}
            />
            <text
              class="node-label"
              x={x + width / 2}
              y={y + (height === 56 ? 23 : 27)}
              text-anchor="middle"
            >
              {nodeLabel}
            </text>
            {feedback ? (
              <text class="node-sub" x={x + width / 2} text-anchor="middle">
                <tspan x={x + width / 2} y={y + 47}>
                  利用結果・誤回答・有人対応結果
                </tspan>
                <tspan x={x + width / 2} y={y + 65}>
                  知識・検索条件・評価を改善
                </tspan>
                <tspan x={x + width / 2} y={y + 82}>
                  次回の検索・回答へ反映
                </tspan>
              </text>
            ) : (
              <text
                class="node-sub"
                x={x + width / 2}
                y={y + (height === 56 ? 43 : 49)}
                text-anchor="middle"
              >
                {nodeSub}
              </text>
            )}
            <text
              class="selected-mark"
              x={x + width - 16}
              y={y + 17}
              aria-hidden="true"
            >
              ✓
            </text>
          </a>
        );
      })}
    </svg>
  ))}
  <div class="diagram-details" aria-label="各工程の説明">
        <section data-diagram-empty>
          <h3>詳しい説明</h3>
          <p>気になる項目を選ぶと、その役割や判断理由を確認できます。</p>
        </section>
    {nodes.map((node) => (
      <div id={`support-detail-${node.id}`} data-detail={node.id}>
        <h3>{node.label}</h3>
        <p>{node.description}</p>
      </div>
    ))}
  </div>
  <p
    class="diagram-announcement"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></p>
</figure>
<script>
  import { enhanceCaseDiagrams } from "../lib/interactive-diagrams";
  enhanceCaseDiagrams();
  document.addEventListener("astro:page-load", enhanceCaseDiagrams);
</script>
<style>
  /* Widen only the explanatory figure; keep surrounding reading line lengths. */
  :global(.prose:has(> [data-support-dx])) {
    max-width: none;
  }
  :global(.prose:has(> [data-support-dx]) > :not([data-support-dx])) {
    max-width: 78ch;
  }

  .support-dx {
    margin: 1.5rem 0;
    padding: clamp(0.65rem, 2vw, 1.25rem);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    min-width: 0;
    container-type: inline-size;
    scroll-margin-top: 7rem;
  }
  figcaption {
    font-weight: 600;
    color: var(--ink);
  }
  .diagram-help {
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0.5rem 0 1rem;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .diagram-desktop {
    display: none;
  }
  .diagram-mobile {
    display: block;
    max-width: 420px;
    margin-inline: auto;
  }
  marker path {
    fill: var(--accent);
  }
  .flow-lines path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }
  .feedback-path {
    stroke-dasharray: 5 4;
  }
  .flow-labels {
    fill: var(--muted);
    font-size: 12px;
  }
  [data-node] {
    color: var(--ink);
    text-decoration: none;
  }
  [data-enhanced] [data-node] {
    cursor: pointer;
  }
  rect {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 2;
  }
  [data-kind="knowledge"] rect,
  [data-kind="rag"] rect {
    fill: var(--soft);
  }
  [data-kind="genai"] rect {
    stroke-width: 3;
  }
  [data-kind="decision"] rect {
    stroke: var(--accent);
  }
  [data-kind="human"] rect {
    stroke-dasharray: 4 3;
  }
  [data-kind="response"] rect {
    fill: var(--soft);
    stroke: var(--accent);
  }
  [data-kind="feedback"] rect {
    fill: var(--bg);
  }
  .node-label {
    fill: var(--ink);
    font:
      600 18px system-ui,
      sans-serif;
  }
  .node-sub {
    fill: var(--muted);
    font:
      11px system-ui,
      sans-serif;
  }
  .diagram-mobile .node-label {
    font-size: 18px;
  }
  .diagram-mobile .node-sub,
  .diagram-mobile .flow-labels {
    font-size: 14px;
  }
  .selected-mark {
    display: none;
    fill: var(--accent);
    font-size: 14px;
  }
  [aria-pressed="true"] rect {
    fill: var(--soft);
    stroke: var(--accent);
    stroke-width: 3;
  }
  [aria-pressed="true"] .selected-mark {
    display: block;
  }
  [data-node]:focus-visible {
    outline: none;
  }
  [data-node]:focus-visible rect {
    stroke: var(--accent);
    stroke-width: 4;
    stroke-dasharray: 5 3;
  }
  .diagram-details {
    min-height: 8rem;
    box-sizing: border-box;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1rem;
    margin-top: 1rem;
  }
  .diagram-details [data-detail] {
    scroll-margin-top: 7rem;
  }
  .diagram-details h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .diagram-details p {
    margin: 0;
  }
  /* CSS anchors remain functional without JavaScript; reserve the detail panel. */
  .diagram-details [data-detail] {
    display: none;
  }
  .diagram-details [data-detail]:target {
    display: block;
  }
  .diagram-details:has(:target) [data-detail]:not(:target) {
    display: none;
  }
  .diagram-details:has(:target) [data-diagram-empty],
  .diagram-details [data-diagram-empty][hidden] {
    display: none;
  }
  [data-enhanced] .diagram-details [data-detail]:not([hidden]) {
    display: block;
  }
  [data-enhanced] .diagram-details [data-detail][hidden] {
    display: none;
  }
  .diagram-announcement {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @keyframes flow-reveal {
    from {
      opacity: 0.8;
    }
    to {
      opacity: 1;
    }
  }
  .flow-reveal [data-node] {
    animation: flow-reveal 400ms ease-out both;
    animation-delay: calc(var(--step) * 55ms);
  }
  @container (min-width: 640px) {
    .diagram-details {
      min-height: 8rem;
    }
    .diagram-desktop {
      display: block;
    }
    .diagram-mobile {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-reveal [data-node] {
      animation: none;
    }
  }
</style>
