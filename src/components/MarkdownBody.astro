---
import { load } from "cheerio";
import { getCollection } from "astro:content";
import { publicEntry, url } from "../lib/site";
import { publicHtml, normalizeSourceUrl } from "../lib/public-html.mjs";
import { imageDimensions } from "../lib/image-metadata";
const sourceLinks = new Map<string, string>([
  ["https://zenn.dev/nullcontroller", url("ai")],
  ["https://github.com/nullcontroller/Rosarium", url("ai-design")],
  ["https://github.com/nullcontroller/Rosarium/wiki", url("ai-design")],
]);
for (const entry of await getCollection("pages", publicEntry)) {
  for (const source of [entry.data.source?.url, entry.data.canonical]) {
    if (source) sourceLinks.set(normalizeSourceUrl(source), url(entry.id));
  }
}
import InteractiveCaseDiagram from "./InteractiveCaseDiagram.astro";
import InteractiveSupportDxDiagram from "./InteractiveSupportDxDiagram.astro";
import Principle from "./Principle.astro";
import Decision from "./Decision.astro";
import Risk from "./Risk.astro";
import Responsibility from "./Responsibility.astro";
import Evidence from "./Evidence.astro";
import Case from "./Case.astro";
import Note from "./Note.astro";
interface Props {
  html: string;
}
const components = {
  principle: Principle,
  decision: Decision,
  risk: Risk,
  responsibility: Responsibility,
  evidence: Evidence,
  case: Case,
  note: Note,
};
const $ = load(publicHtml(Astro.props.html, sourceLinks), null, false);
// Case discovery belongs to Cases/Career, not to knowledge article bodies.
// Keep the reference wording and source metadata, but remove its navigation.
if (!/\/(?:cases|career)(?:\/|$)/.test(Astro.url.pathname)) {
  $("a[href]").each((_, element) => {
    const link = $(element);
    if (/\/cases(?:\/|$)/.test(link.attr("href") || "")) link.replaceWith(link.contents());
  });
}
$("img").each((_, element) => {
  const image = $(element);
  image.attr("loading", "lazy");
  image.attr("decoding", "async");
  const dimensions = imageDimensions(image.attr("src"));
  if (dimensions) {
    image.attr("width", String(dimensions.width));
    image.attr("height", String(dimensions.height));
  }
});
const nodes = $.root().contents().toArray();
---

{nodes.map((node) => {
  const el = $(node);
  const kind = el.attr("data-kind") as keyof typeof components;
  const Block = components[kind];
  return el.is("[data-support-dx-diagram]") ? (
    <InteractiveSupportDxDiagram />
  ) : el.is("[data-case-diagram]") ? (
    <InteractiveCaseDiagram id={el.attr("data-case-diagram")!} />
  ) : Block ? (
    <Block title={el.attr("data-title")}>
      <Astro.self html={el.html() || ""} />
    </Block>
  ) : (
    <Fragment set:html={$.html(node)} />
  );
})}
