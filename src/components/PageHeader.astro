---
import { navigation } from "../lib/navigation";
import { introductionForPath } from "../lib/site";
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";
interface Props {
  icon?: IconName;
  navigationPath?: string;
  title: string;
  eyebrow?: string;
  summary?: string;
  summaryParagraphs?: string[];
  status?: string;
}
const {
  icon: explicitIcon,
  navigationPath,
  title,
  eyebrow,
  summary = introductionForPath(Astro.url.pathname),
  summaryParagraphs,
  status,
} = Astro.props;
const icon = explicitIcon ?? (navigationPath === undefined ? undefined : navigation.flat().find((item) => item.path === navigationPath)?.icon);
---

<header class:list={["page-heading", !icon && "text-only"]}>
  {icon && <Icon name={icon} size="page" />}
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <div class="page-title-with-status">
      <h1>{title}</h1>
      {status && <span class="page-status">{status}</span>}
    </div>
    {(summaryParagraphs ?? (summary ? [summary] : [])).map((paragraph) => <p class="lead">{paragraph}</p>)}
  </div>
</header>
