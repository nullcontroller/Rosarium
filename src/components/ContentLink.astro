---
import { contentCategory, publicationType } from "../lib/navigation";
import { iconForEntry } from "../lib/icons";
import type { CollectionEntry } from "astro:content";
import { formatDateJa, url } from "../lib/site";
import { dxCategoryForId } from "../lib/dx";
import Icon from "./Icon.astro";
interface Props {
  entry: CollectionEntry<"pages">;
  heading?: "h2" | "h3" | "p";
  current?: boolean;
  showIcon?: boolean;
}
const { entry, heading: Heading = "h2", current = false, showIcon = true } = Astro.props;
const d = entry.data;
const format = publicationType(entry);
// Discovery entry points and secondary categories remain metadata, not badges.
const category = dxCategoryForId(d.primaryCategory ?? "")?.title ?? contentCategory(entry);
const inTheme = /\/(?:ai|ai-design|dx)(?:\/|$)/.test(Astro.url.pathname);
const showCategory = !inTheme && !(format === "Essay" && category === "Essays");
---

<div class:list={["content-entry", showIcon && "icon-entry"]} data-content-id={entry.id}>
  {showIcon && <Icon name={iconForEntry(entry)} size="list" />}
  <div>
    <p class="meta content-entry-meta">
      <span>{format}</span>
      {showCategory && <span>{category}</span>}
      最終更新：{formatDateJa(d.last_updated)}
    </p>
    <Heading class="content-title">
      <a href={url(entry.id)} aria-current={current ? "page" : undefined}>
        {d.title}
      </a>
    </Heading>
    <p class="content-summary">{d.summary}</p>
  </div>
</div>
