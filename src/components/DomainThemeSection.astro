---
import type { CollectionEntry } from "astro:content";
import { url } from "../lib/site";
interface Props {
  id: string;
  title: string;
  path: string;
  paragraphs: readonly string[];
  questions: readonly string[];
  articles: CollectionEntry<"pages">[];
  domain: "ai" | "dx";
}
const { id, title, path, paragraphs, questions, articles, domain } = Astro.props;
---

<!-- Both domains retain the existing DX typography and responsive rules. -->
<section class="dx-category" id={id} data-domain-theme={domain} aria-labelledby={`${id}-heading`}>
  <header class="dx-theme-introduction">
    <h2 id={`${id}-heading`}><a href={url(path)}>{title}</a></h2>
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </header>
  <div class="dx-theme-detail">
    <h3>このテーマで考えること</h3>
    <ul class="dx-theme-questions">
      {questions.map((question) => <li>{question}</li>)}
    </ul>
    <h3>最初に読む</h3>
    <ul class="dx-featured-articles">
      {articles.map((entry) => (
        <li data-dx-featured={domain === "dx" ? entry.id : undefined} data-ai-featured={domain === "ai" ? entry.id : undefined}>
          <h4><a href={url(entry.id)}>{entry.data.title}</a></h4>
          <p>{entry.data.summary}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
