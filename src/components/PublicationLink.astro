---
import type { Entry } from "../lib/navigation";
import {
  publicationType,
  publicationStatus,
  publicationTiming,
  caseStudies,
} from "../lib/navigation";
import { iconForEntry } from "../lib/icons";
import { formatDateJa, url } from "../lib/site";
import { contentUseCases } from "../lib/use-cases";
import Icon from "./Icon.astro";
interface Props {
  entry: Entry;
  heading?: "h2" | "h3" | "p";
  showIcon?: boolean;
}
const { entry, heading: Heading = "h3", showIcon = true } = Astro.props;
const d = entry.data;
const purposes = contentUseCases(entry);
const timing = publicationTiming(entry);
const publicationState = publicationStatus(entry);
const caseStudy = caseStudies.find((study) => study.book === entry.id);
---

<div class:list={["content-entry", "publication-entry", showIcon && "icon-entry"]} data-content-id={entry.id} data-lifecycle={d.lifecycle}>
  {showIcon && <Icon name={iconForEntry(entry)} size="list" />}
  <div>
    <Heading class="content-title">
      <a href={url(entry.id)}>{d.title}</a>
    </Heading>
    {d.lifecycle === "obsolete" && caseStudy && (
      <p class="case-reference-note"><span>OBSOLETE</span> {caseStudy.referenceNote}</p>
    )}
    {d.lifecycle === "obsolete" && !caseStudy && <p class="case-reference-note"><span>OBSOLETE</span> 当時の前提に基づく参考記事</p>}
    <p class="content-summary">{d.summary}</p>
    {purposes.length > 0 && (
      <p class="meta publication-purpose publication-topics">
        {purposes.map((purpose) => purpose.shortTitle).join(" / ")}
      </p>
    )}
    <p class="meta publication-date">
      {publicationState && <span>状態：{publicationState}</span>}
      <span>{timing.label}：{timing.datetime ? (
        <time datetime={timing.datetime}>{timing.value}</time>
      ) : (
        timing.value
      )}</span>
      <span>{publicationType(entry)}</span>
      最終更新：{formatDateJa(d.last_updated)}
    </p>
  </div>
</div>
