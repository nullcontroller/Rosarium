---
const review = Boolean(process.env.ROSARIUM_DRAFT_PREVIEW);
---
<aside data-pwa-status role="status" hidden></aside>
<script define:vars={{ review }}>
  const allowed = review
    ? location.hostname === 'nullcontroller.tail8bbb3b.ts.net' || ['localhost', '127.0.0.1'].includes(location.hostname)
    : location.hostname === 'rosarium-tech.com';
  const status = document.querySelector('[data-pwa-status]');
  if (document.body.dataset.pwaOffline && status) {
    status.textContent = 'オフラインのため、保存済みの内容を表示しています。接続後に再読み込みすると最新版を確認できます。';
    status.hidden = false;
  }
  if (allowed && isSecureContext && 'serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js', { scope: '/', updateViaCache: 'none' }).then(registration => {
      const waiting = () => {
        if (registration.active && registration.waiting && status && !document.body.dataset.pwaOffline) {
          status.textContent = '新しい版を準備しました。Rosariumのタブやアプリをすべて閉じ、再度開くと適用されます。';
          status.hidden = false;
        }
      };
      waiting();
      registration.addEventListener('updatefound', () => registration.installing?.addEventListener('statechange', waiting));
    }).catch(() => { /* Ordinary browsing remains available if registration is denied. */ });
  }
</script>
<style>
  [data-pwa-status]:not([hidden]) { margin: 12px max(12px, env(safe-area-inset-right)) 12px max(12px, env(safe-area-inset-left)); padding: 12px 16px; border: 1px solid currentColor; border-radius: 8px; background: var(--bg, #f5f3e9); color: var(--ink, #17383b); font-size: 1rem; line-height: 1.6; }
</style>
