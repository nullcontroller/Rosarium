---
import type { Entry } from "../lib/navigation";
import PublicationLink from "./PublicationLink.astro";
import { url, base } from "../lib/site";
import { imageDimensions } from "../lib/image-metadata";
interface Props {
  entry: Entry;
  all: Entry[];
  showCover?: boolean;
  showIcons?: boolean;
}
const { entry, showCover = true, showIcons = true } = Astro.props;
const hasCover = showCover && Boolean(entry.data.cover);
const coverDimensions = imageDimensions(
  entry.data.cover ? base + entry.data.cover : undefined,
);
---

<article
  class:list={["book-list-entry", !hasCover && "book-list-entry-text"]}
  data-series-index={entry.id}
>
  {hasCover && (
    <a href={url(entry.id)} tabindex="-1" aria-hidden="true">
      <img
        src={base + entry.data.cover}
        alt=""
        width={coverDimensions?.width || 120}
        height={coverDimensions?.height}
        loading="lazy"
        decoding="async"
      />
    </a>
  )}
  <div>
    <PublicationLink entry={entry} heading="h2" showIcon={showIcons && !hasCover} />
    <slot name="details" />

  </div>
</article>
