---
import type { SitemapNode } from "../lib/reader-sitemap";
import { url } from "../lib/site";
interface Props { node: SitemapNode; depth?: number; }
const {node,depth=0}=Astro.props;
---
<li data-sitemap-node={node.path}>
  {node.children.length ? <details open={depth===0 && !node.contentId}>
    <summary><span>{node.title}</span> <small>{node.format && `${node.format} · `}{node.count ? `${node.count}記事` : "横断索引"}</small></summary>
    <p class="sitemap-parent"><a href={url(node.path)} data-reference-page data-sitemap-link data-sitemap-content={node.contentId}>{node.contentId ? node.title : `${node.title}を開く`}</a></p>
    <ul>{node.children.map(child=><Astro.self node={child} depth={depth+1} />)}</ul>
  </details> : <span class="sitemap-leaf">{node.area && <strong class="design-area">{node.area}</strong>}<a href={url(node.path)} data-reference-page data-sitemap-link data-sitemap-content={node.contentId}>{node.title}</a>{node.format && <small> · {node.format}</small>}</span>}
</li>
